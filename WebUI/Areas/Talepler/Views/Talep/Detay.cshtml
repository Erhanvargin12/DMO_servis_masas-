@model WebUI.Areas.Talepler.Models.TalepDetayViewModel
@{
    ViewData["Title"] = "Talep Detayı";
    var talep = Model.Talep;
    var meId = int.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var mid) ? mid : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/talepler.css" asp-append-version="true" />
}

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="margin-bottom:16px;">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="margin-bottom:16px;">@TempData["ErrorMessage"]</div>
}

<!-- Page Header -->
<div class="mgmt-page-header">
    <div class="mgmt-page-header-left">
        <a href="@Url.Action("Taleplerim", "Talep", new { area = "Talepler" })" class="btn btn-ghost btn-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
        </a>
        <div>
            <div class="mgmt-page-title">@talep.Baslik</div>
            <div class="mgmt-page-subtitle">
                #@talep.Id &nbsp;•&nbsp;
                <span class="badge @talep.OncelikCss">@talep.OncelikAdi</span>
                &nbsp;
                <span class="badge @talep.DurumCss">@talep.DurumAdi</span>
            </div>
        </div>
    </div>
    <div class="talep-header-actions">
        @if (!talep.Kapali)
        {
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="yanitModal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                Yanıtla
            </button>
            <button type="button" class="btn btn-sm" data-modal-open="sevkModal">Sevk Et</button>
            <button type="button" class="btn btn-sm" data-modal-open="atamaModal">Kullanıcı Ata</button>
            <button type="button" class="btn btn-sm" data-modal-open="durumModal">Durum Değiştir</button>
            <form asp-area="Talepler" asp-controller="Talep" asp-action="Kapat" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="talepId" value="@talep.Id" />
                <button type="submit" class="btn btn-sm"
                        onclick="return confirm('Talep kapatılsın mı?')">Kapat</button>
            </form>
        }
    </div>
</div>

<div class="talep-detay-grid">

    <!-- Sol Kolon: Detay + Yanıtlar + Chat -->
    <div class="talep-detay-main">

        <!-- Genel Bilgiler -->
        <div class="data-table talep-section">
            <div class="talep-section-header">
                <span class="talep-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    Genel Bilgiler
                </span>
            </div>
            <div class="talep-section-body">
                <div class="talep-info-grid">
                    <div class="talep-info-item">
                        <span class="talep-info-label">Kategori</span>
                        <span class="talep-info-value">@talep.KategoriAdi</span>
                    </div>
                    <div class="talep-info-item">
                        <span class="talep-info-label">Oluşturan</span>
                        <span class="talep-info-value">@talep.OlusturanAdi</span>
                    </div>
                    <div class="talep-info-item">
                        <span class="talep-info-label">Atanan</span>
                        <span class="talep-info-value">@(talep.AtananAdi ?? "—")</span>
                    </div>
                    <div class="talep-info-item">
                        <span class="talep-info-label">Oluşturma</span>
                        <span class="talep-info-value">@talep.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    @if (talep.KapanmaTarihi.HasValue)
                    {
                        <div class="talep-info-item">
                            <span class="talep-info-label">Kapanış</span>
                            <span class="talep-info-value">@talep.KapanmaTarihi.Value.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                    }
                </div>
                <div class="talep-aciklama">
                    <div class="talep-info-label" style="margin-bottom: 8px;">Açıklama</div>
                    <div class="talep-aciklama-text">@talep.Aciklama</div>
                </div>
            </div>
        </div>

        <!-- Yanıt Geçmişi -->
        <div class="data-table talep-section">
            <div class="talep-section-header">
                <span class="talep-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                    Yanıt Geçmişi
                </span>
                <span class="stat-chip">@Model.Yanitlar.Count yanıt</span>
            </div>
            <div class="talep-section-body">
                @if (Model.Yanitlar.Any())
                {
                    foreach (var yanit in Model.Yanitlar)
                    {
                        <div class="yanit-card">
                            <div class="yanit-header">
                                <div class="entity-badge entity-badge-user">
                                    @(yanit.KullaniciAdi.Length > 0 ? yanit.KullaniciAdi[..1].ToUpper() : "?")
                                </div>
                                <div class="yanit-meta">
                                    <span class="yanit-kullanici">@yanit.KullaniciAdi</span>
                                    <span class="yanit-tarih">@yanit.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                            </div>
                            <div class="yanit-icerik">@yanit.Icerik</div>
                            @if (yanit.Ekler.Any())
                            {
                                <div class="yanit-ekler">
                                    <span class="talep-info-label">Ekler:</span>
                                    <div class="ek-list-inline">
                                        @foreach (var ek in yanit.Ekler)
                                        {
                                            <a href="@Url.Action("EkIndir", "Talep", new { area = "Talepler", ekId = ek.Id })"
                                               class="ek-chip" title="@ek.DosyaAdi (@ek.BoyutMetni)">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                                                </svg>
                                                @ek.DosyaAdi
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="talep-empty-state">
                        <p>Henüz yanıt eklenmemiş.</p>
                    </div>
                }

                @if (!talep.Kapali)
                {
                    <div style="margin-top: 16px;">
                        <button type="button" class="btn btn-primary btn-sm" data-modal-open="yanitModal">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                            </svg>
                            Yanıt Ekle
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Chat -->
        <div class="data-table talep-section">
            <div class="talep-section-header">
                <span class="talep-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 2H3v16h5v4l4-4h9z"/>
                    </svg>
                    İç Yazışma (Chat)
                </span>
                <span class="stat-chip">@Model.Chat.Count mesaj</span>
            </div>
            <div class="talep-section-body">
                <div class="chat-container" id="chatContainer">
                    @if (Model.Chat.Any())
                    {
                        foreach (var msg in Model.Chat)
                        {
                            <div class="chat-mesaj @(msg.BenimMi ? "chat-ben" : "chat-diger")">
                                @if (!msg.BenimMi)
                                {
                                    <div class="entity-badge entity-badge-user" style="flex-shrink:0;">
                                        @(msg.GonderenAdi.Length > 0 ? msg.GonderenAdi[..1].ToUpper() : "?")
                                    </div>
                                }
                                <div class="chat-bubble-wrap">
                                    @if (!msg.BenimMi)
                                    {
                                        <span class="chat-gonderen">@msg.GonderenAdi</span>
                                    }
                                    <div class="chat-bubble">@msg.Mesaj</div>
                                    <span class="chat-tarih">@msg.OlusturmaTarihi.ToString("dd.MM HH:mm")</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="talep-empty-state">
                            <p>Henüz mesaj gönderilmemiş.</p>
                        </div>
                    }
                </div>

                @if (!talep.Kapali)
                {
                    <form asp-area="Talepler" asp-controller="Talep" asp-action="ChatEkle" method="post" class="chat-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="talepId" value="@talep.Id" />
                        <div class="chat-input-row">
                            <input type="text" name="mesaj" class="form-input" placeholder="Mesajınızı yazın..." autocomplete="off" required />
                            <button type="submit" class="btn btn-primary btn-sm">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
                                </svg>
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>

    </div>

    <!-- Sağ Kolon: Ekler + Atamalar + Sevkler -->
    <div class="talep-detay-sidebar">

        <!-- Ekler -->
        <div class="data-table talep-section">
            <div class="talep-section-header">
                <span class="talep-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                    </svg>
                    Ekler
                </span>
                <span class="stat-chip">@Model.Ekler.Count</span>
            </div>
            <div class="talep-section-body">
                @if (Model.Ekler.Any())
                {
                    <div class="ek-list">
                        @foreach (var ek in Model.Ekler)
                        {
                            <div class="ek-item">
                                <a href="@Url.Action("EkIndir", "Talep", new { area = "Talepler", ekId = ek.Id })"
                                   class="ek-dosya-link" title="İndir">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                                    </svg>
                                    <span class="ek-adi">@ek.DosyaAdi</span>
                                    <span class="ek-boyut">@ek.BoyutMetni</span>
                                </a>
                                @if (!talep.Kapali)
                                {
                                    <form asp-area="Talepler" asp-controller="Talep" asp-action="EkSil" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ekId" value="@ek.Id" />
                                        <input type="hidden" name="talepId" value="@talep.Id" />
                                        <button type="submit" class="btn btn-icon btn-ghost btn-sm btn-icon-danger"
                                                onclick="return confirm('Dosya silinsin mi?')" title="Sil">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                            </svg>
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="talep-empty-state">Ek yok.</p>
                }

                @if (!talep.Kapali)
                {
                    <form asp-area="Talepler" asp-controller="Talep" asp-action="EkEkle" method="post"
                          enctype="multipart/form-data" class="ek-yukle-form" style="margin-top: 12px;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="talepId" value="@talep.Id" />
                        <div class="ek-yukle-row">
                            <input type="file" name="dosya" class="form-input" style="font-size: 0.8rem;" />
                            <button type="submit" class="btn btn-sm btn-primary" style="white-space:nowrap;">Yükle</button>
                        </div>
                    </form>
                }
            </div>
        </div>

        <!-- Atama Geçmişi -->
        <div class="data-table talep-section">
            <div class="talep-section-header">
                <span class="talep-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    Atama Geçmişi
                </span>
            </div>
            <div class="talep-section-body">
                @if (Model.Atamalar.Any())
                {
                    <div class="gecmis-list">
                        @foreach (var atama in Model.Atamalar)
                        {
                            <div class="gecmis-item">
                                <div class="gecmis-ikon">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                                    </svg>
                                </div>
                                <div class="gecmis-icerik">
                                    <span class="gecmis-baslik">@atama.AtananAdi</span>
                                    <span class="gecmis-alt">@atama.AtayanAdi tarafından</span>
                                    @if (!string.IsNullOrEmpty(atama.Aciklama))
                                    {
                                        <span class="gecmis-aciklama">@atama.Aciklama</span>
                                    }
                                    <span class="gecmis-tarih">@atama.AtamaTarihi.ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="talep-empty-state">Atama geçmişi yok.</p>
                }

                @if (!talep.Kapali)
                {
                    <button type="button" class="btn btn-sm" style="margin-top: 12px;"
                            data-modal-open="atamaModal">
                        Kullanıcı Ata
                    </button>
                }
            </div>
        </div>

        <!-- Sevk Geçmişi -->
        <div class="data-table talep-section">
            <div class="talep-section-header">
                <span class="talep-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/>
                        <path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>
                    </svg>
                    Sevk Geçmişi
                </span>
            </div>
            <div class="talep-section-body">
                @if (Model.Sevkler.Any())
                {
                    <div class="gecmis-list">
                        @foreach (var sevk in Model.Sevkler)
                        {
                            <div class="gecmis-item">
                                <div class="gecmis-ikon">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="5 12 19 12"/><polyline points="12 5 19 12 12 19"/>
                                    </svg>
                                </div>
                                <div class="gecmis-icerik">
                                    <span class="gecmis-baslik">
                                        @(sevk.HedefKullaniciAdi ?? sevk.HedefRolAdi ?? "—")
                                    </span>
                                    <span class="gecmis-alt">@sevk.SevkEdenAdi tarafından</span>
                                    @if (!string.IsNullOrEmpty(sevk.Aciklama))
                                    {
                                        <span class="gecmis-aciklama">@sevk.Aciklama</span>
                                    }
                                    <span class="gecmis-tarih">@sevk.SevkTarihi.ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="talep-empty-state">Sevk geçmişi yok.</p>
                }

                @if (!talep.Kapali)
                {
                    <button type="button" class="btn btn-sm" style="margin-top: 12px;"
                            data-modal-open="sevkModal">
                        Sevk Et
                    </button>
                }
            </div>
        </div>

    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- MODAL: Yanıt Ekle                                                       -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="yanitModal">
    <div class="modal">
        <div class="modal-header">
            <h3 class="modal-title">Yanıt Ekle</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-area="Talepler" asp-controller="Talep" asp-action="Yanitla" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="talepId" value="@talep.Id" />
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Yanıt <span class="text-error">*</span></label>
                    <textarea name="icerik" class="form-input" rows="5"
                              placeholder="Yanıtınızı yazın..." required></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Ek Dosyalar</label>
                    <input type="file" name="ekler" class="form-input" multiple />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary">Yanıtla</button>
            </div>
        </form>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- MODAL: Durum Değiştir                                                   -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="durumModal">
    <div class="modal modal-sm">
        <div class="modal-header">
            <h3 class="modal-title">Durum Değiştir</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-area="Talepler" asp-controller="Talep" asp-action="DurumGuncelle" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="talepId" value="@talep.Id" />
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Yeni Durum</label>
                    <select name="durum" class="form-input">
                        <option value="1" @(talep.Durum == 1 ? "selected" : "")>Açık</option>
                        <option value="2" @(talep.Durum == 2 ? "selected" : "")>İşleniyor</option>
                        <option value="3" @(talep.Durum == 3 ? "selected" : "")>Beklemede</option>
                        <option value="4" @(talep.Durum == 4 ? "selected" : "")>Kapalı</option>
                        <option value="5" @(talep.Durum == 5 ? "selected" : "")>İptal</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary">Güncelle</button>
            </div>
        </form>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- MODAL: Sevk Et                                                          -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="sevkModal">
    <div class="modal">
        <div class="modal-header">
            <h3 class="modal-title">Talep Sevk Et</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-area="Talepler" asp-controller="Talep" asp-action="Sevk" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="talepId" value="@talep.Id" />
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Hedef Kullanıcı</label>
                    <select name="hedefKullaniciId" class="form-input">
                        <option value="">— Seçiniz (opsiyonel) —</option>
                        @foreach (var u in Model.KullaniciListesi)
                        {
                            <option value="@u.Value">@u.Text</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Hedef Rol</label>
                    <select name="hedefRolId" class="form-input">
                        <option value="">— Seçiniz (opsiyonel) —</option>
                        @foreach (var r in Model.RolListesi)
                        {
                            <option value="@r.Value">@r.Text</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Açıklama</label>
                    <textarea name="aciklama" class="form-input" rows="3"
                              placeholder="Sevk nedeni (opsiyonel)..."></textarea>
                </div>
                <p class="text-muted" style="font-size:0.8rem; margin-top:4px;">
                    * Kullanıcı veya rolden en az biri seçilmelidir.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary">Sevk Et</button>
            </div>
        </form>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- MODAL: Kullanıcı Ata                                                    -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="atamaModal">
    <div class="modal modal-sm">
        <div class="modal-header">
            <h3 class="modal-title">Kullanıcı Ata</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-area="Talepler" asp-controller="Talep" asp-action="Atama" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="talepId" value="@talep.Id" />
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Kullanıcı <span class="text-error">*</span></label>
                    <select name="atananKullaniciId" class="form-input" required>
                        <option value="">Seçiniz...</option>
                        @foreach (var u in Model.KullaniciListesi)
                        {
                            <option value="@u.Value" @(talep.AtananKullaniciId?.ToString() == u.Value ? "selected" : "")>
                                @u.Text
                            </option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Açıklama</label>
                    <textarea name="aciklama" class="form-input" rows="3"
                              placeholder="Atama notu (opsiyonel)..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary">Ata</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/talepler.js" asp-append-version="true"></script>
}
