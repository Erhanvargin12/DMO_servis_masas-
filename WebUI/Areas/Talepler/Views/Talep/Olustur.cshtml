@model WebUI.Areas.Talepler.Models.TalepOlusturViewModel
@{
    ViewData["Title"] = "Yeni Talep";
}

@section Styles {
    <link rel="stylesheet" href="~/css/talepler.css" asp-append-version="true" />
}

<!-- Page Header -->
<div class="mgmt-page-header">
    <div class="mgmt-page-header-left">
        <a href="@Url.Action("Liste", "Talep", new { area = "Talepler" })" class="btn btn-ghost btn-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
        </a>
        <div>
            <div class="mgmt-page-title">Yeni Talep Oluştur</div>
            <div class="mgmt-page-subtitle">Yeni bir destek talebi oluşturun</div>
        </div>
    </div>
</div>

<div class="content-narrow">
    <div class="data-table">
        <div class="data-table-header">
            <div class="data-table-title">Talep Bilgileri</div>
        </div>
        <div style="padding: 24px;">
            <form asp-area="Talepler" asp-controller="Talep" asp-action="Olustur" method="post"
                  enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-error" style="margin-bottom: 16px;"></div>

                <div class="form-group">
                    <label asp-for="Baslik" class="form-label required"></label>
                    <input asp-for="Baslik" class="form-input" placeholder="Talebinizi özetleyen kısa bir başlık yazın" />
                    <span asp-validation-for="Baslik" class="form-error"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="KategoriId" class="form-label required"></label>
                        <select asp-for="KategoriId" asp-items="Model.KategoriListesi" class="form-input">
                            <option value="">Kategori seçin</option>
                        </select>
                        <span asp-validation-for="KategoriId" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Oncelik" class="form-label"></label>
                        <select asp-for="Oncelik" asp-items="Model.OncelikListesi" class="form-input"></select>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Aciklama" class="form-label required"></label>
                    <textarea asp-for="Aciklama" class="form-input form-textarea" rows="6"
                              placeholder="Talebinizi detaylı olarak açıklayın..."></textarea>
                    <span asp-validation-for="Aciklama" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Ekler (Opsiyonel)</label>
                    <div class="ek-yukle-area">
                        <input type="file" name="Ekler" multiple class="form-input"
                               accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.txt,.zip" />
                        <span class="form-help">PDF, Word, Excel, görsel veya zip dosyaları (maks. 10MB/dosya)</span>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="@Url.Action("Liste", "Talep", new { area = "Talepler" })" class="btn">İptal</a>
                    <button type="submit" class="btn btn-primary">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        Talep Oluştur
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

