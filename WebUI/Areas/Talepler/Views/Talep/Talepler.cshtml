@model WebUI.Areas.Talepler.Models.TalepAnaSayfaViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.AktifSayfa switch
    {
        "Taleplerim"    => "Taleplerim",
        "Bekleyenler"   => "Birimde Bekleyen Talepler",
        "Tamamlananlar" => "Tamamlanan Talepler",
        "Gorevlerim"    => "Görevli Olduğum Talepler",
        _               => "Talepler"
    };
    var searchAction = Model.AktifSayfa;
}

@section Styles {
    <link rel="stylesheet" href="~/css/talepler.css" asp-append-version="true" />
}

<!-- Page Header -->
<div class="mgmt-page-header">
    <div class="mgmt-page-header-left">
        <div>
            <div class="mgmt-page-title">@ViewData["Title"]</div>
            <div class="mgmt-page-subtitle">@Model.TotalCount kayıt</div>
        </div>
    </div>
    <div class="mgmt-page-header-right">
        <button type="button" class="btn btn-primary btn-sm" data-modal-open="yeniTalepModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Yeni Talep
        </button>
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="margin-bottom:16px;">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="margin-bottom:16px;">@TempData["ErrorMessage"]</div>
}

<!-- Tab Navigasyonu -->
<div class="talep-tabs">
    <a href="@Url.Action("Taleplerim", "Talep", new { area = "Talepler" })"
       class="talep-tab @(Model.AktifSayfa == "Taleplerim" ? "active" : "")">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
        </svg>
        Taleplerim
    </a>
    <a href="@Url.Action("Bekleyenler", "Talep", new { area = "Talepler" })"
       class="talep-tab @(Model.AktifSayfa == "Bekleyenler" ? "active" : "")">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        Birimde Bekleyenler
    </a>
    <a href="@Url.Action("Tamamlananlar", "Talep", new { area = "Talepler" })"
       class="talep-tab @(Model.AktifSayfa == "Tamamlananlar" ? "active" : "")">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
        </svg>
        Tamamlananlar
    </a>
    <a href="@Url.Action("Gorevlerim", "Talep", new { area = "Talepler" })"
       class="talep-tab @(Model.AktifSayfa == "Gorevlerim" ? "active" : "")">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
        </svg>
        Görevlerim
    </a>
</div>

<!-- Arama Çubuğu -->
<form method="get" asp-area="Talepler" asp-controller="Talep" asp-action="@searchAction"
      class="talep-filter-bar">
    <input type="text" name="search" value="@Model.SearchTerm"
           class="form-input" placeholder="Başlık, açıklama veya kullanıcı ara..." />
    <button type="submit" class="btn btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        Ara
    </button>
    @if (!string.IsNullOrEmpty(Model.SearchTerm))
    {
        <a href="@Url.Action(searchAction, "Talep", new { area = "Talepler" })" class="btn btn-ghost btn-sm">Temizle</a>
    }
</form>

<!-- Tablo -->
<div class="data-table">
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Başlık</th>
                <th>Kategori</th>
                <th>Öncelik</th>
                <th>Durum</th>
                <th>Oluşturan</th>
                <th>Atanan</th>
                <th>Tarih</th>
                <th class="text-right">İşlem</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Talepler.Any())
            {
                foreach (var t in Model.Talepler)
                {
                    <tr data-talep-id="@t.Id"
                        data-baslik="@t.Baslik"
                        data-aciklama="@t.Aciklama"
                        data-kategori-id="@t.KategoriId"
                        data-oncelik="@t.Oncelik">
                        <td class="text-muted" style="font-size:0.8rem;">@t.Id</td>
                        <td>
                            <a href="@Url.Action("Detay", "Talep", new { area = "Talepler", id = t.Id })"
                               class="table-link">@t.Baslik</a>
                        </td>
                        <td><span class="text-muted">@t.KategoriAdi</span></td>
                        <td><span class="badge @t.OncelikCss">@t.OncelikAdi</span></td>
                        <td><span class="badge @t.DurumCss">@t.DurumAdi</span></td>
                        <td>@t.OlusturanAdi</td>
                        <td>@(t.AtananAdi ?? "—")</td>
                        <td class="text-muted" style="font-size:0.8rem;">@t.OlusturmaTarihi.ToString("dd.MM.yyyy")</td>
                        <td class="text-right">
                            <div class="table-actions">
                                <a href="@Url.Action("Detay", "Talep", new { area = "Talepler", id = t.Id })"
                                   class="btn btn-ghost btn-sm btn-icon" title="Detay">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                </a>
                                @if (!t.Kapali)
                                {
                                    <button type="button" class="btn btn-ghost btn-sm btn-icon"
                                            title="Düzenle"
                                            data-modal-open="duzenleModal"
                                            data-talep-id="@t.Id"
                                            data-baslik="@t.Baslik"
                                            data-aciklama="@t.Aciklama"
                                            data-kategori-id="@t.KategoriId"
                                            data-oncelik="@t.Oncelik">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </button>
                                }
                                <button type="button" class="btn btn-ghost btn-sm btn-icon btn-icon-danger"
                                        title="Sil"
                                        data-modal-open="silModal"
                                        data-talep-id="@t.Id"
                                        data-baslik="@t.Baslik">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"/>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center text-muted" style="padding: 32px;">
                        Bu bölümde henüz talep bulunmuyor.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <div class="pagination-wrap">
        @if (Model.HasPreviousPage)
        {
            <a href="@Url.Action(searchAction, "Talep", new { area = "Talepler", page = Model.PageNumber - 1, search = Model.SearchTerm })"
               class="btn btn-ghost btn-sm">‹ Önceki</a>
        }
        <span class="pagination-info text-muted" style="font-size:0.85rem; padding: 0 12px;">
            @Model.PageNumber / @Model.TotalPages
        </span>
        @if (Model.HasNextPage)
        {
            <a href="@Url.Action(searchAction, "Talep", new { area = "Talepler", page = Model.PageNumber + 1, search = Model.SearchTerm })"
               class="btn btn-ghost btn-sm">Sonraki ›</a>
        }
    </div>
}

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- MODAL: Yeni Talep                                                       -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="yeniTalepModal">
    <div class="modal">
        <div class="modal-header">
            <h3 class="modal-title">Yeni Talep Oluştur</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-area="Talepler" asp-controller="Talep" asp-action="Olustur" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Başlık <span class="text-error">*</span></label>
                    <input type="text" name="Baslik" class="form-input"
                           placeholder="En az 5 karakter" required minlength="5" />
                </div>
                <div class="form-group">
                    <label class="form-label">Açıklama <span class="text-error">*</span></label>
                    <textarea name="Aciklama" class="form-input" rows="4"
                              placeholder="Talebi detaylı açıklayın..." required></textarea>
                </div>
                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label">Kategori <span class="text-error">*</span></label>
                        <select name="KategoriId" class="form-input" required>
                            <option value="">Seçiniz...</option>
                            @foreach (var k in Model.OlusturForm.KategoriListesi)
                            {
                                <option value="@k.Value">@k.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Öncelik</label>
                        <select name="Oncelik" class="form-input">
                            <option value="1">Düşük</option>
                            <option value="2" selected>Normal</option>
                            <option value="3">Yüksek</option>
                            <option value="4">Kritik</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Ek Dosyalar</label>
                    <input type="file" name="Ekler" class="form-input" multiple />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary">Oluştur</button>
            </div>
        </form>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- MODAL: Talep Düzenle                                                    -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="duzenleModal">
    <div class="modal">
        <div class="modal-header">
            <h3 class="modal-title">Talep Düzenle</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-area="Talepler" asp-controller="Talep" asp-action="Guncelle" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="duzenleId" name="Id" />
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Başlık <span class="text-error">*</span></label>
                    <input type="text" id="duzenleBaslik" name="Baslik" class="form-input"
                           required minlength="5" />
                </div>
                <div class="form-group">
                    <label class="form-label">Açıklama <span class="text-error">*</span></label>
                    <textarea id="duzenleAciklama" name="Aciklama" class="form-input" rows="4" required></textarea>
                </div>
                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label">Kategori <span class="text-error">*</span></label>
                        <select id="duzenleKategori" name="KategoriId" class="form-input" required>
                            <option value="">Seçiniz...</option>
                            @foreach (var k in Model.OlusturForm.KategoriListesi)
                            {
                                <option value="@k.Value">@k.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Öncelik</label>
                        <select id="duzenleOncelik" name="Oncelik" class="form-input">
                            <option value="1">Düşük</option>
                            <option value="2">Normal</option>
                            <option value="3">Yüksek</option>
                            <option value="4">Kritik</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- MODAL: Talep Sil Onayı                                                  -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="silModal">
    <div class="modal modal-sm">
        <div class="modal-header">
            <h3 class="modal-title">Talep Sil</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-area="Talepler" asp-controller="Talep" asp-action="Sil" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="silTalepId" name="talepId" />
            <div class="modal-body">
                <div class="alert alert-danger" style="margin:0;">
                    <strong id="silBaslik"></strong> talebi kalıcı olarak silinecektir. Emin misiniz?
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-danger">Evet, Sil</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/talepler.js" asp-append-version="true"></script>
}

