@using WebUI.Areas.Tickets.Models
@model FaqArticle
@{
    ViewData["Title"] = Model.Title;
}

<div style="max-width: 900px; margin: 0 auto; padding-bottom: 40px;">
    <!-- Back Link -->
    <div style="margin-bottom: 20px;">
        <a href="@Url.Action("Faq", "Ticket", new { area = "Tickets" })"
           style="color: var(--accent); font-weight: 600; font-size: 13.5px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-arrow-left"></i> Bilgi Bankasına Dön
        </a>
    </div>

    <!-- Article Header Card -->
    <div class="card" style="border-radius: 16px; border: 1px solid var(--border); padding: 30px; background: var(--bg-surface); margin-bottom: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 14px;">
            <span class="badge" style="background: rgba(99, 102, 241, 0.1); color: #4f46e5; border: 1px solid rgba(99, 102, 241, 0.25); font-size: 12px; font-weight: 700; border-radius: 8px; padding: 4px 12px;">
                <i class="fa-solid @Model.Icon" style="margin-right: 6px;"></i> @Model.Category
            </span>
            <span style="font-size: 12px; color: var(--text-muted);">
                <i class="fa-regular fa-clock" style="margin-right: 4px;"></i> Güncelleme: @Model.UpdatedAt.ToString("dd.MM.yyyy")
            </span>
            <span style="font-size: 12px; color: var(--text-muted); margin-left: auto;">
                <i class="fa-regular fa-eye" style="margin-right: 4px;"></i> @Model.ViewCount Görüntülenme
            </span>
        </div>

        <h1 style="font-size: 24px; font-weight: 800; color: var(--text-primary); margin-bottom: 12px; line-height: 1.3;">
            @Model.Title
        </h1>
        <p style="font-size: 15px; color: var(--text-secondary); line-height: 1.6; margin: 0;">
            @Model.Content
        </p>
    </div>

    <!-- Step-by-Step Solution Guide -->
    <div class="card" style="border-radius: 16px; border: 1px solid var(--border); padding: 30px; background: var(--bg-surface); margin-bottom: 24px;">
        <h2 style="font-size: 18px; font-weight: 700; color: var(--text-primary); margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-list-check" style="color: var(--accent);"></i> Adım Adım Çözüm Yönergesi
        </h2>

        <div style="display: flex; flex-direction: column; gap: 16px;">
            @for (int i = 0; i < Model.SolutionSteps.Count; i++)
            {
                <div style="display: flex; gap: 16px; align-items: flex-start; background: var(--bg-secondary); padding: 16px 20px; border-radius: 12px; border-left: 4px solid var(--accent);">
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--accent); color: #ffffff; font-weight: 800; font-size: 14px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        @(i + 1)
                    </div>
                    <div style="font-size: 14px; color: var(--text-primary); font-weight: 500; line-height: 1.5; padding-top: 4px;">
                        @Model.SolutionSteps[i]
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Tags & Feedback Bar -->
    <div class="card" style="border-radius: 16px; border: 1px solid var(--border); padding: 24px; background: var(--bg-surface); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
            <span style="font-size: 12.5px; font-weight: 700; color: var(--text-muted);"><i class="fa-solid fa-tags"></i> Etiketler:</span>
            @foreach (var tag in Model.Tags)
            {
                <span class="badge" style="background: rgba(148, 163, 184, 0.1); color: var(--text-secondary); border: 1px solid var(--border); font-size: 11.5px; border-radius: 6px; padding: 3px 9px;">
                    #@tag
                </span>
            }
        </div>

        <div style="display: flex; align-items: center; gap: 10px;" id="feedbackBox">
            <span style="font-size: 13px; font-weight: 600; color: var(--text-primary);">Bu çözüm yardımcı oldu mu?</span>
            <button type="button" class="btn btn-sm" onclick="markHelpful(this)"
                    style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); color: #059669; font-weight: 700; border-radius: 8px; padding: 6px 14px; display: flex; align-items: center; gap: 6px;">
                <i class="fa-solid fa-thumbs-up"></i> Evet (@Model.HelpfulCount)
            </button>
        </div>
    </div>
</div>

<script>
    function markHelpful(btn) {
        btn.disabled = true;
        btn.style.background = '#10b981';
        btn.style.color = '#ffffff';
        btn.innerHTML = '<i class="fa-solid fa-check"></i> Teşekkürler! (@(Model.HelpfulCount + 1))';
        if (window.AdminUI && window.AdminUI.Toast) {
            AdminUI.Toast.success('Geribildiriminiz için teşekkür ederiz!');
        }
    }
</script>
