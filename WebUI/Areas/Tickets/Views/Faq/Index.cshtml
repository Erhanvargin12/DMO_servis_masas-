@using WebUI.Areas.Tickets.Models
@model KnowledgeBaseViewModel
@{
    ViewData["Title"] = "Bilgi Bankası & SSS";
}

<!-- Hero Search Banner -->
<div style="background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%); border-radius: 20px; padding: 40px 30px; text-align: center; color: #ffffff; margin-bottom: 30px; box-shadow: 0 10px 25px rgba(79, 70, 229, 0.25);">
    <h1 style="font-size: 28px; font-weight: 800; margin-bottom: 8px; letter-spacing: -0.5px;">
        <i class="fa-solid fa-book-bookmark" style="margin-right: 8px;"></i> DMO Akıllı Bilgi Bankası &amp; SSS
    </h1>
    <p style="font-size: 14.5px; opacity: 0.9; margin-bottom: 24px; max-width: 650px; margin-left: auto; margin-right: auto;">
        Talep açmadan önce sık karşılaşılan donanım, yazılım ve ağ çözümlerini arayıp sorununuzu anında çözebilirsiniz.
    </p>

    <!-- Search Form -->
    <form method="get" action="@Url.Action("Faq", "Ticket", new { area = "Tickets" })" style="max-width: 600px; margin: 0 auto; position: relative;">
        <input type="text" name="search" value="@Model.SearchTerm" placeholder="Hangi konuda yardıma ihtiyacınız var? (Şifre, E-posta, VPN, Yazıcı...)"
               style="width: 100%; height: 50px; border-radius: 25px; padding: 0 140px 0 24px; font-size: 14px; border: none; outline: none; box-shadow: 0 4px 15px rgba(0,0,0,0.15); color: #1e293b;" />
        <button type="submit" class="btn" style="position: absolute; right: 6px; top: 6px; height: 38px; border-radius: 20px; padding: 0 20px; background: #4f46e5; color: #ffffff; font-weight: 700; font-size: 13px; border: none; cursor: pointer;">
            <i class="fa-solid fa-magnifying-glass" style="margin-right: 6px;"></i> Çözüm Ara
        </button>
    </form>
</div>

<!-- Categories Filter Chips -->
<div style="display: flex; gap: 10px; overflow-x: auto; padding-bottom: 10px; margin-bottom: 24px; flex-wrap: wrap;">
    <a href="@Url.Action("Faq", "Ticket", new { area = "Tickets" })"
       class="btn" style="border-radius: 20px; font-size: 13px; font-weight: 600; padding: 8px 18px; border: 1px solid var(--border); background: @(string.IsNullOrEmpty(Model.CategoryFilter) ? "var(--accent)" : "var(--bg-secondary)"); color: @(string.IsNullOrEmpty(Model.CategoryFilter) ? "#ffffff" : "var(--text-primary)"); text-decoration: none;">
        Tümü (@Model.TotalArticles)
    </a>
    @foreach (var cat in Model.Categories)
    {
        var active = Model.CategoryFilter == cat;
        <a href="@Url.Action("Faq", "Ticket", new { area = "Tickets", category = cat })"
           class="btn" style="border-radius: 20px; font-size: 13px; font-weight: 600; padding: 8px 18px; border: 1px solid var(--border); background: @(active ? "var(--accent)" : "var(--bg-secondary)"); color: @(active ? "#ffffff" : "var(--text-primary)"); text-decoration: none;">
            @cat
        </a>
    }
</div>

<!-- FAQ Articles List Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; margin-bottom: 30px;">
    @if (Model.Articles.Any())
    {
        @foreach (var article in Model.Articles)
        {
            <div class="card" style="border-radius: 16px; border: 1px solid var(--border); display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s, box-shadow 0.2s; background: var(--bg-surface);"
                 onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 12px 24px rgba(0,0,0,0.08)';"
                 onmouseout="this.style.transform='none'; this.style.boxShadow='none';">
                
                <div class="card-body" style="padding: 22px;">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 14px;">
                        <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(79, 70, 229, 0.1); color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            <i class="fa-solid @article.Icon"></i>
                        </div>
                        <div>
                            <span class="badge" style="background: rgba(99, 102, 241, 0.08); color: #4f46e5; border: 1px solid rgba(99, 102, 241, 0.2); font-size: 11px; font-weight: 700; border-radius: 6px; padding: 2px 8px;">
                                @article.Category
                            </span>
                            <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                                <i class="fa-regular fa-eye"></i> @article.ViewCount görüntülenme
                            </div>
                        </div>
                    </div>

                    <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--text-primary); line-height: 1.4;">
                        @article.Title
                    </h3>
                    <p style="font-size: 13px; color: var(--text-muted); line-height: 1.5; margin-bottom: 16px;">
                        @article.Summary
                    </p>

                    <!-- Quick Solution Steps Preview -->
                    <div style="background: var(--bg-secondary); border-radius: 10px; padding: 12px; margin-bottom: 16px; border: 1px solid var(--border);">
                        <div style="font-size: 11.5px; font-weight: 700; color: var(--accent); margin-bottom: 6px; display: flex; align-items: center; gap: 4px;">
                            <i class="fa-solid fa-list-check"></i> Hızlı Çözüm Adımları:
                        </div>
                        <ul style="margin: 0; padding-left: 16px; font-size: 12px; color: var(--text-secondary); line-height: 1.4;">
                            @foreach (var step in article.SolutionSteps.Take(2))
                            {
                                <li>@step</li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="card-footer" style="padding: 14px 22px; background: var(--bg-secondary); border-top: 1px solid var(--border); border-radius: 0 0 16px 16px; display: flex; justify-content: space-between; align-items: center;">
                    <div style="font-size: 12px; color: #10b981; font-weight: 600; display: flex; align-items: center; gap: 4px;">
                        <i class="fa-solid fa-thumbs-up"></i> @article.HelpfulCount kişi faydalı buldu
                    </div>
                    <a href="@Url.Action("FaqDetail", "Ticket", new { area = "Tickets", id = article.Id })"
                       class="btn btn-sm btn-primary" style="font-size: 12px; font-weight: 600; padding: 6px 14px; border-radius: 8px; text-decoration: none;">
                        Çözümü Oku <i class="fa-solid fa-arrow-right" style="margin-left: 4px;"></i>
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div style="grid-column: 1 / -1; padding: 50px; text-align: center; color: var(--text-muted); background: var(--bg-surface); border-radius: 16px; border: 1px solid var(--border);">
            <i class="fa-solid fa-folder-open" style="font-size: 42px; margin-bottom: 14px; color: var(--border);"></i>
            <div style="font-size: 16px; font-weight: 700;">Arama kriterinize uygun çözüm makalesi bulunamadı.</div>
            <div style="font-size: 13px; margin-top: 6px; margin-bottom: 20px;">Farklı kelimelerle arama yapabilir veya doğrudan yeni teknik destek talebi oluşturabilirsiniz.</div>
            <a href="/Tickets/Ticket/Index" class="btn btn-primary" style="padding: 10px 20px; font-size: 13.5px; font-weight: 600; border-radius: 10px;">
                <i class="fa-solid fa-plus"></i> Yeni Destek Talebi Aç
            </a>
        </div>
    }
</div>

<!-- CTA Banner: Did not find solution? -->
<div style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 16px; padding: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="width: 50px; height: 50px; border-radius: 14px; background: rgba(16, 185, 129, 0.12); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 22px;">
            <i class="fa-solid fa-headset"></i>
        </div>
        <div>
            <div style="font-size: 16px; font-weight: 700; color: var(--text-primary);">Aradığınız Çözümü Bulamadınız mı?</div>
            <div style="font-size: 13px; color: var(--text-muted); margin-top: 2px;">Şube müdürlüğü destek ekibimiz taleplerinize 7/24 hızlı çözüm üretmektedir.</div>
        </div>
    </div>
    <a href="/Tickets/Ticket/Index" class="btn btn-primary" style="padding: 12px 24px; font-size: 14px; font-weight: 700; border-radius: 10px; text-decoration: none;">
        <i class="fa-solid fa-plus" style="margin-right: 6px;"></i> Anında Destek Talebi Oluştur
    </a>
</div>
