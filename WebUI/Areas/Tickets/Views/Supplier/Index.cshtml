@model WebUI.Areas.Tickets.Models.TicketViewModel
@{
    ViewData["Title"] = "Tedarikçi Servis Portalı";

    string StatusBadge(int? id) => id switch
    {
        1 => "badge-status-open",
        2 => "badge-status-assigned",
        3 => "badge-status-progress",
        4 => "badge-status-waiting",
        5 => "badge-status-resolved",
        6 => "badge-status-closed",
        _ => ""
    };
    string StatusLabel(int? id) => id switch
    {
        1 => "Açık (Saha Talebi)",
        2 => "Atandı",
        3 => "Servis İnceleniyor",
        4 => "Yedek Parça Bekleniyor",
        5 => "Servis Tamamlandı",
        6 => "Kapatıldı",
        _ => "—"
    };
    string PriorityBadge(int id) => id switch
    {
        1 => "badge-priority-low",
        2 => "badge-priority-medium",
        3 => "badge-priority-high",
        4 => "badge-priority-critical",
        _ => ""
    };
    string PriorityLabel(int id) => id switch
    {
        1 => "Düşük",
        2 => "Orta",
        3 => "Yüksek",
        4 => "Kritik",
        _ => "—"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/tickets.css" asp-append-version="true" />
}

<!-- Page Header -->
<div class="mgmt-page-header" style="background: linear-gradient(135deg, #059669 0%, #047857 100%); color:#ffffff; padding:24px; border-radius:16px; margin-bottom:20px; box-shadow:0 4px 12px rgba(5,150,105,0.2);">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <div>
            <h1 style="font-size:22px; font-weight:800; margin:0 0 6px 0; display:flex; align-items:center; gap:10px;">
                <i class="fa-solid fa-handshake-angle"></i>
                Tedarikçi &amp; Dış Hizmet Sağlayıcı Portalı
            </h1>
            <p style="margin:0; font-size:13.5px; opacity:0.9;">
                🏢 <strong>@ViewBag.CompanyName</strong> &nbsp;·&nbsp; ✉️ @ViewBag.CompanyEmail
            </p>
        </div>
        <div style="display:flex; align-items:center; gap:12px;">
            <button type="button" class="btn" onclick="openCallCenterModal()" style="background:#ffffff; color:#047857; font-size:13.5px; font-weight:800; padding:10px 18px; border-radius:24px; border:none; box-shadow:0 2px 8px rgba(0,0,0,0.15); cursor:pointer; display:inline-flex; align-items:center; gap:8px; transition:all 0.2s ease;">
                <i class="fa-solid fa-headset" style="font-size:16px; color:#059669;"></i> 📞 Çağrı Merkezine Talep Bildir
            </button>
            <span class="badge" style="background:rgba(255,255,255,0.2); color:#ffffff; padding:8px 16px; font-size:13px; font-weight:700; border-radius:20px;">
                <i class="fa-solid fa-shield-check" style="margin-right:6px;"></i> Onaylı Yüklenici
            </span>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:16px; margin-bottom:20px;">
    <div class="stat-card" style="border-left:4px solid #059669; padding:16px; background:var(--bg-card); border-radius:12px; box-shadow:0 2px 6px rgba(0,0,0,0.04);">
        <div style="font-size:12px; font-weight:700; color:var(--text-secondary); text-transform:uppercase;">Sevk Edilen İş Sayısı</div>
        <div style="font-size:24px; font-weight:800; color:#059669; margin-top:4px;">@Model.OwnCount</div>
    </div>
    <div class="stat-card" style="border-left:4px solid #3b82f6; padding:16px; background:var(--bg-card); border-radius:12px; box-shadow:0 2px 6px rgba(0,0,0,0.04);">
        <div style="font-size:12px; font-weight:700; color:var(--text-secondary); text-transform:uppercase;">Ortalama Servis SLA Süresi</div>
        <div style="font-size:24px; font-weight:800; color:#3b82f6; margin-top:4px;">4 Saat</div>
    </div>
    <div class="stat-card" style="border-left:4px solid #f59e0b; padding:16px; background:var(--bg-card); border-radius:12px; box-shadow:0 2px 6px rgba(0,0,0,0.04);">
        <div style="font-size:12px; font-weight:700; color:var(--text-secondary); text-transform:uppercase;">Parça / Saha Müdahale</div>
        <div style="font-size:24px; font-weight:800; color:#f59e0b; margin-top:4px;">Aktif Saha Ekibi</div>
    </div>
</div>

<!-- Main Table Container -->
<div class="data-table" style="margin-bottom:20px;">
    <div class="filter-wrap">
        <form method="get" asp-action="Index" asp-controller="Supplier" asp-area="Tickets" class="filter-form">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-input search-input" placeholder="Tedarikçi taleplerinde ara..." />
            </div>
            <button type="submit" class="btn btn-primary" style="background:#059669;">Ara</button>
        </form>
    </div>

    <div class="table-container">
        <table class="table mgmt-table" id="supplierTable">
            <thead>
                <tr>
                    <th>Talep No</th>
                    <th>Başlık &amp; Arıza Tanımı</th>
                    <th>Öncelik</th>
                    <th>Servis Durumu</th>
                    <th>Tarih</th>
                    <th style="text-align:right;">Tedarikçi Aksiyonları</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.FilteredTickets != null && Model.FilteredTickets.Any())
                {
                    foreach (var t in Model.FilteredTickets)
                    {
                        <tr>
                            <td><span class="entity-badge-text">@t.TicketNo</span></td>
                            <td>
                                <div>
                                    <strong style="font-size:13.5px; color:var(--text-primary);">@t.Title</strong>
                                    <div style="font-size:12px; color:var(--text-secondary); margin-top:2px;">@t.Description</div>
                                </div>
                            </td>
                            <td><span class="badge @PriorityBadge(t.PriorityId)">@PriorityLabel(t.PriorityId)</span></td>
                            <td><span class="badge @StatusBadge(t.StatusId)">@StatusLabel(t.StatusId)</span></td>
                            <td style="font-size:12px;">@t.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td style="text-align:right;">
                                <button type="button" class="btn" onclick="openSupplierModal(@t.Id, '@t.TicketNo')" style="background:#059669; color:#ffffff; font-size:12px; font-weight:700; padding:6px 12px; border-radius:8px;">
                                    <i class="fa-solid fa-wrench" style="margin-right:4px;"></i> Servis Güncelle
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align:center; padding:30px; color:var(--text-secondary);">
                            <i class="fa-solid fa-inbox" style="font-size:24px; margin-bottom:8px; display:block;"></i>
                            Firmaya henüz sevk edilmiş aktif talep bulunmamaktadır.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Supplier Update Modal -->
<div class="modal-overlay" id="supplierModal">
    <div class="modal modal-md">
        <div class="modal-header" style="background:#059669; color:#ffffff;">
            <h3 class="modal-title" style="color:#ffffff;">
                <i class="fa-solid fa-screwdriver-wrench" style="margin-right:8px;"></i>
                Saha / Tedarikçi Servis Notu Gir - <span id="modalTicketNoDisplay"></span>
            </h3>
            <button type="button" class="modal-close" onclick="closeTicketModal('supplierModal')" style="color:#ffffff;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form action="/Tickets/Supplier/UpdateStatus" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ticketId" id="modalSupplierTicketId" />
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label required">Servis &amp; Müdahale Durumu</label>
                    <select name="statusId" class="form-input" required>
                        <option value="3">🛠️ Servis İnceleniyor / Saha Ekibi Yönlendirildi</option>
                        <option value="4">⏳ Yedek Parça Bekleniyor (Yurt Dışı / Tedarik)</option>
                        <option value="5" selected>✅ Servis Tamamlandı / Arıza Giderildi</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Saha / Servis Rapor Notu</label>
                    <textarea name="serviceNote" class="form-input form-textarea" rows="4" placeholder="Değiştirilen parça, yapılan testler ve teknik servis notunu yazınız..." required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" onclick="closeTicketModal('supplierModal')">İptal</button>
                <button type="submit" class="btn" style="background:#059669; color:#ffffff; font-weight:700;">
                    <i class="fa-solid fa-check"></i> Servis Raporunu Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

<!-- New Call Center Ticket Modal -->
<div class="modal-overlay" id="newCallCenterTicketModal">
    <div class="modal modal-md">
        <div class="modal-header" style="background:#047857; color:#ffffff;">
            <h3 class="modal-title" style="color:#ffffff;">
                <i class="fa-solid fa-headset" style="margin-right:8px;"></i>
                Çağrı Merkezi Müdürlüğü'ne Talep Bildir
            </h3>
            <button type="button" class="modal-close" onclick="closeTicketModal('newCallCenterTicketModal')" style="color:#ffffff;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form action="/Tickets/Supplier/CreateTicket" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label required">Talep Konusu / Başlık</label>
                    <input type="text" name="title" class="form-input" placeholder="Örn: Yazıcı Sarf Malzeme Sevk Talebi veya Garanti Arızası" required />
                </div>
                <div class="form-group">
                    <label class="form-label required">Hizmet / Arıza Kategorisi</label>
                    <select name="categoryName" class="form-input" required>
                        <option value="Saha &amp; Donanım Servisi">🛠️ Saha &amp; Donanım Servisi</option>
                        <option value="Ağ &amp; Fiber Altyapı">🌐 Ağ &amp; Fiber Altyapı</option>
                        <option value="Sarf Malzeme &amp; Parça">📦 Sarf Malzeme &amp; Parça Sevk</option>
                        <option value="Yazılım &amp; Lisans">💻 Yazılım &amp; Lisans Desteği</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label required">Öncelik Seviyesi</label>
                    <select name="priorityId" class="form-input" required>
                        <option value="1">Düşük</option>
                        <option value="2" selected>Orta (Normal)</option>
                        <option value="3">Yüksek</option>
                        <option value="4">Kritik (Acil Müdahale)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label required">Talep Açıklaması &amp; İhtiyaç Detayı</label>
                    <textarea name="description" class="form-input form-textarea" rows="4" placeholder="Çağrı Merkezi temsilcilerimizin incelemesi için talep detayını ve lokasyonu yazınız..." required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" onclick="closeTicketModal('newCallCenterTicketModal')">İptal</button>
                <button type="submit" class="btn" style="background:#047857; color:#ffffff; font-weight:800;">
                    <i class="fa-solid fa-paper-plane" style="margin-right:6px;"></i> Çağrı Merkezine Gönder
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openSupplierModal(id, no) {
        document.getElementById('modalSupplierTicketId').value = id;
        document.getElementById('modalTicketNoDisplay').innerText = no;
        document.getElementById('supplierModal').classList.add('active');
    }
    function openCallCenterModal() {
        document.getElementById('newCallCenterTicketModal').classList.add('active');
    }
    function closeTicketModal(id) {
        document.getElementById(id).classList.remove('active');
    }
</script>
