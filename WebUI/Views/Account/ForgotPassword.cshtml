@using WebUI.Models
@using WebUI.Models.ViewModels
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "_AuthLayout";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-logo">
            <div class="auth-logo-icon">
                <i class="fa-solid fa-lock"></i>
            </div>
            <h1>Şifre Sıfırlama</h1>
            <p>E-posta adresinizi girin</p>
        </div>

        @if (Model.IsSubmitted)
        {
            <div class="alert alert-success">
                <i class="fa-solid fa-circle-check"></i>
                <div>
                    <strong>E-posta gönderildi!</strong>
                    <p>Şifre sıfırlama bağlantısı <strong>@Model.Email</strong> adresine gönderildi. Lütfen e-postanızı kontrol edin.</p>
                </div>
            </div>
            
            <div class="auth-footer">
                <a asp-action="Login" class="btn-back">
                    <i class="fa-solid fa-arrow-left"></i>
                    Giriş sayfasına dön
                </a>
            </div>
        }
        else
        {
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-error">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                <div class="form-group">
                    <label class="form-label" for="email">E-posta Adresi</label>
                    <input type="email" 
                           class="form-input @(ViewData.ModelState["Email"]?.Errors.Any() == true ? "error" : "")" 
                           id="email" 
                           asp-for="Email" 
                           placeholder="ornek@email.com" />
                    <span asp-validation-for="Email" class="validation-message"></span>
                </div>

                <button type="submit" class="btn-submit">Şifre Sıfırlama Linki Gönder</button>
            </form>

            <div class="auth-footer">
                <a asp-action="Login" class="btn-back">
                    <i class="fa-solid fa-arrow-left"></i>
                    Giriş sayfasına dön
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
