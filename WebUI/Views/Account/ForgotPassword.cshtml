@model WebUI.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "_AuthLayout";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-logo">
            <div class="auth-logo-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
            </div>
            <h1>Şifre Sıfırlama</h1>
            <p>E-posta adresinizi girin</p>
        </div>

        @if (Model.IsSubmitted)
        {
            <div class="alert alert-success">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                <div>
                    <strong>E-posta gönderildi!</strong>
                    <p>Şifre sıfırlama bağlantısı <strong>@Model.Email</strong> adresine gönderildi. Lütfen e-postanızı kontrol edin.</p>
                </div>
            </div>
            
            <div class="auth-footer">
                <a asp-action="Login" class="btn-back">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="19" y1="12" x2="5" y2="12"/>
                        <polyline points="12 19 5 12 12 5"/>
                    </svg>
                    Giriş sayfasına dön
                </a>
            </div>
        }
        else
        {
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-error">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                <div class="form-group">
                    <label class="form-label" for="email">E-posta Adresi</label>
                    <input type="email" 
                           class="form-input @(ViewData.ModelState["Email"]?.Errors.Any() == true ? "error" : "")" 
                           id="email" 
                           asp-for="Email" 
                           placeholder="ornek@email.com" />
                    <span asp-validation-for="Email" class="validation-message"></span>
                </div>

                <button type="submit" class="btn-submit">Şifre Sıfırlama Linki Gönder</button>
            </form>

            <div class="auth-footer">
                <a asp-action="Login" class="btn-back">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="19" y1="12" x2="5" y2="12"/>
                        <polyline points="12 19 5 12 12 5"/>
                    </svg>
                    Giriş sayfasına dön
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

