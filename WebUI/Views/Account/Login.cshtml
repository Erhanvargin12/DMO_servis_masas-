@model WebUI.Models.LoginViewModel
@{
    ViewData["Title"] = "Giriş";
    Layout = "_AuthLayout";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-logo">
            <div class="auth-logo-icon">B</div>
            <h1>BackendCore</h1>
            <p>Hesabınıza giriş yapın</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="Login" asp-controller="Account" method="post">
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-group">
                <label class="form-label" for="email">E-posta</label>
                <input type="email" 
                       class="form-input @(ViewData.ModelState["Email"]?.Errors.Any() == true ? "error" : "")" 
                       id="email" 
                       asp-for="Email" 
                       placeholder="ornek@email.com" />
                <span asp-validation-for="Email" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label class="form-label" for="password">Şifre</label>
                <input type="password" 
                       class="form-input @(ViewData.ModelState["Password"]?.Errors.Any() == true ? "error" : "")" 
                       id="password" 
                       asp-for="Password" 
                       placeholder="••••••••" />
                <span asp-validation-for="Password" class="validation-message"></span>
            </div>

            <div class="form-check">
                <input type="checkbox" id="rememberMe" asp-for="RememberMe" />
                <label for="rememberMe">Beni hatırla</label>
            </div>

            <button type="submit" class="btn-submit">Giriş Yap</button>
        </form>

        <div class="auth-footer">
            <span>Hesabınız yok mu?</span>
            <a href="#">Kayıt Ol</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
