@model WebUI.Models.LoginViewModel
@{
    ViewData["Title"] = "Giriş";
    Layout = "_AuthLayout";
    
    // Sadece kayıt ve şifre sıfırlama başarı mesajlarını göster
    var successMessage = TempData["RegisterSuccess"] ?? TempData["PasswordResetSuccess"];
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-logo">
            <div class="auth-logo-icon">B</div>
            <h1>BackendCore</h1>
            <p>Hesabınıza giriş yapın</p>
        </div>

        @if (successMessage != null)
        {
            <div class="alert alert-success">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                <span>@successMessage</span>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="Login" asp-controller="Account" method="post" id="loginForm">
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-group">
                <label class="form-label" for="email">E-posta</label>
                <input type="email" 
                       class="form-input @(ViewData.ModelState["Email"]?.Errors.Any() == true ? "error" : "")" 
                       id="email" 
                       asp-for="Email" 
                       placeholder="ornek@email.com" 
                       autocomplete="email" />
                <span asp-validation-for="Email" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label class="form-label" for="password">Şifre</label>
                <input type="password" 
                       class="form-input @(ViewData.ModelState["Password"]?.Errors.Any() == true ? "error" : "")" 
                       id="password" 
                       asp-for="Password" 
                       placeholder="••••••••" 
                       autocomplete="current-password" />
                <span asp-validation-for="Password" class="validation-message"></span>
            </div>

            <div class="form-options">
                <div class="form-check">
                    <input type="checkbox" id="rememberMe" asp-for="RememberMe" />
                    <label for="rememberMe">Beni hatırla</label>
                </div>
                <a asp-action="ForgotPassword" class="forgot-link">Şifremi Unuttum</a>
            </div>

            <button type="submit" class="btn-submit" id="submitBtn">Giriş Yap</button>
        </form>

        <div class="auth-footer">
            <span>Hesabınız yok mu?</span>
            <a asp-action="Register">Kayıt Ol</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
