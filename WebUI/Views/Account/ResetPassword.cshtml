@model WebUI.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Şifre Sıfırla";
    Layout = "_AuthLayout";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-logo">
            <div class="auth-logo-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                </svg>
            </div>
            <h1>Yeni Şifre Belirle</h1>
            <p>Hesabınız için yeni şifre oluşturun</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="ResetPassword" asp-controller="Account" method="post">
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div class="form-group">
                <label class="form-label" for="newPassword">Yeni Şifre</label>
                <input type="password" 
                       class="form-input @(ViewData.ModelState["NewPassword"]?.Errors.Any() == true ? "error" : "")" 
                       id="newPassword" 
                       asp-for="NewPassword" 
                       placeholder="En az 6 karakter" />
                <span asp-validation-for="NewPassword" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label class="form-label" for="confirmPassword">Şifre Tekrar</label>
                <input type="password" 
                       class="form-input @(ViewData.ModelState["ConfirmPassword"]?.Errors.Any() == true ? "error" : "")" 
                       id="confirmPassword" 
                       asp-for="ConfirmPassword" 
                       placeholder="Şifrenizi tekrar girin" />
                <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
            </div>

            <button type="submit" class="btn-submit">Şifreyi Değiştir</button>
        </form>

        <div class="auth-footer">
            <a asp-action="Login" class="btn-back">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                Giriş sayfasına dön
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

