@{
    ViewData["Title"] = "Sunucu Hatası";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-container">
    <div class="auth-card" style="text-align:center; max-width:480px;">
        <div style="font-size:64px; line-height:1; margin-bottom:20px; opacity:0.12; font-weight:800; color:#111;">500</div>
        <div style="width:56px;height:56px;background:#fff7ed;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
            <i class="fa-solid fa-triangle-exclamation" style="font-size:28px;color:#ea580c;"></i>
        </div>
        <h1 style="font-size:20px;font-weight:700;color:#111;margin-bottom:10px;">Bir Sorun Oluştu</h1>
        <p style="font-size:14px;color:#666;margin-bottom:28px;line-height:1.6;">
            İsteğiniz işlenirken beklenmeyen bir hata oluştu.<br />
            Sorun devam ederse lütfen sistem yöneticinize bildirin.
        </p>
        <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
            <a href="/" class="btn-submit" style="display:inline-block;text-decoration:none;padding:10px 22px;">
                Ana Sayfaya Dön
            </a>
            <a href="javascript:location.reload()" class="btn-submit"
               style="display:inline-block;text-decoration:none;padding:10px 22px;background:#f4f4f5;color:#333;">
                Yenile
            </a>
        </div>
    </div>
</div>

