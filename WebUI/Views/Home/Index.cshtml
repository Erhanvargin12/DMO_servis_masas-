@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stats -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-label">Kullanıcılar</div>
        <div class="stat-value">1,248</div>
        <div class="stat-change up">+12% bu ay</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Aktif Oturum</div>
        <div class="stat-value">156</div>
        <div class="stat-change up">+8% bu hafta</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">API İsteği</div>
        <div class="stat-value">24.5K</div>
        <div class="stat-change down">-3% dünden</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Uptime</div>
        <div class="stat-value">99.9%</div>
        <div class="stat-change">Stabil</div>
    </div>
</div>

<!-- Content Grid -->
<div class="grid grid-2">
    <!-- Quick Actions -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Hızlı İşlemler</h3>
        </div>
        <div class="card-body">
            <div class="actions-list">
                <a href="/Users" class="action-item">
                    <div class="action-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="8.5" cy="7" r="4"/>
                            <line x1="20" y1="8" x2="20" y2="14"/>
                            <line x1="23" y1="11" x2="17" y2="11"/>
                        </svg>
                    </div>
                    <span>Kullanıcı Yönetimi</span>
                </a>
                <a href="/Roles" class="action-item">
                    <div class="action-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </div>
                    <span>Rol Yönetimi</span>
                </a>
                <a href="#" class="action-item">
                    <div class="action-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                        </svg>
                    </div>
                    <span>Sistem Ayarları</span>
                </a>
                <a href="#" class="action-item">
                    <div class="action-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                        </svg>
                    </div>
                    <span>Log Kayıtları</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Son Aktiviteler</h3>
            <a href="#" class="btn btn-ghost btn-sm">Tümünü Gör</a>
        </div>
        <div class="card-body">
            <div class="activity-list">
                <div class="activity-item">
                    <div class="activity-dot green"></div>
                    <div>
                        <div class="activity-text">Yeni kullanıcı kaydoldu</div>
                        <div class="activity-time">2 dakika önce</div>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-dot blue"></div>
                    <div>
                        <div class="activity-text">Admin rolü güncellendi</div>
                        <div class="activity-time">15 dakika önce</div>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-dot orange"></div>
                    <div>
                        <div class="activity-text">Sistem ayarları değiştirildi</div>
                        <div class="activity-time">1 saat önce</div>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-dot"></div>
                    <div>
                        <div class="activity-text">5 kullanıcı çıkış yaptı</div>
                        <div class="activity-time">3 saat önce</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
