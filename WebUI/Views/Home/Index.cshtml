@model WebUI.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stats -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-label">Toplam Kullanıcı</div>
        <div class="stat-value">@Model.TotalUsers</div>
        <div class="stat-change">Kayıtlı hesap</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Aktif Kullanıcı</div>
        <div class="stat-value">@Model.ActiveUsers</div>
        <div class="stat-change up">@(Model.TotalUsers > 0 ? $"%{(int)((double)Model.ActiveUsers / Model.TotalUsers * 100)} aktif" : "—")</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Toplam Rol</div>
        <div class="stat-value">@Model.TotalRoles</div>
        <div class="stat-change">Tanımlı rol</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Pasif Kullanıcı</div>
        <div class="stat-value">@(Model.TotalUsers - Model.ActiveUsers)</div>
        <div class="stat-change down">Devre dışı hesap</div>
    </div>
</div>

<!-- Content Grid -->
<div class="grid grid-2">
    <!-- Quick Actions -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Hızlı İşlemler</h3>
        </div>
        <div class="card-body">
            <div class="actions-list">
                <a href="/Users" class="action-item">
                    <div class="action-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="8.5" cy="7" r="4"/>
                            <line x1="20" y1="8" x2="20" y2="14"/>
                            <line x1="23" y1="11" x2="17" y2="11"/>
                        </svg>
                    </div>
                    <span>Kullanıcı Yönetimi</span>
                </a>
                <a href="/Roles" class="action-item">
                    <div class="action-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </div>
                    <span>Rol Yönetimi</span>
                </a>
                <a href="/Menus" class="action-item">
                    <div class="action-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="3" y1="12" x2="21" y2="12"/>
                            <line x1="3" y1="6" x2="21" y2="6"/>
                            <line x1="3" y1="18" x2="21" y2="18"/>
                        </svg>
                    </div>
                    <span>Menü Yönetimi</span>
                </a>
                <a href="/Settings" class="action-item">
                    <div class="action-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                        </svg>
                    </div>
                    <span>Sistem Ayarları</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Özet -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Sistem Özeti</h3>
        </div>
        <div class="card-body">
            <div class="activity-list">
                <div class="activity-item">
                    <div class="activity-dot green"></div>
                    <div>
                        <div class="activity-text">@Model.TotalUsers kayıtlı kullanıcı mevcut</div>
                        <div class="activity-time">@Model.ActiveUsers aktif, @(Model.TotalUsers - Model.ActiveUsers) pasif</div>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-dot blue"></div>
                    <div>
                        <div class="activity-text">@Model.TotalRoles rol tanımlanmış</div>
                        <div class="activity-time">Kullanıcılara atanabilir</div>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-dot"></div>
                    <div>
                        <div class="activity-text">Profil bilgilerinizi güncelleyin</div>
                        <div class="activity-time"><a href="/Profile">Profilime Git →</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
