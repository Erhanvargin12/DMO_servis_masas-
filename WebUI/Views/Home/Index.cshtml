@using WebUI.Models
@using WebUI.Models.ViewModels
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stats -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-label">Toplam Kullanıcı</div>
        <div class="stat-value">@Model.TotalUsers</div>
        <div class="stat-change">Kayıtlı hesap</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Aktif Kullanıcı</div>
        <div class="stat-value">@Model.ActiveUsers</div>
        <div class="stat-change up">@(Model.TotalUsers > 0 ? $"%{(int)((double)Model.ActiveUsers / Model.TotalUsers * 100)} aktif" : "—")</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Toplam Rol</div>
        <div class="stat-value">@Model.TotalRoles</div>
        <div class="stat-change">Tanımlı rol</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Pasif Kullanıcı</div>
        <div class="stat-value">@(Model.TotalUsers - Model.ActiveUsers)</div>
        <div class="stat-change down">Devre dışı hesap</div>
    </div>
</div>

<!-- Content Grid -->
<div class="grid grid-2">
    <!-- Quick Actions -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Hızlı İşlemler</h3>
        </div>
        <div class="card-body">
            <div class="actions-list">
                <a href="/Users" class="action-item">
                    <div class="action-icon">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>
                    <span>Kullanıcı Yönetimi</span>
                </a>
                <a href="/Roles" class="action-item">
                    <div class="action-icon">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <span>Rol Yönetimi</span>
                </a>
                <a href="/Menus" class="action-item">
                    <div class="action-icon">
                        <i class="fa-solid fa-bars"></i>
                    </div>
                    <span>Menü Yönetimi</span>
                </a>
                <a href="/Profile" class="action-item">
                    <div class="action-icon">
                        <i class="fa-solid fa-user"></i>
                    </div>
                    <span>Profilim</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Özet -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Sistem Özeti</h3>
        </div>
        <div class="card-body">
            <div class="activity-list">
                <div class="activity-item">
                    <div class="activity-dot green"></div>
                    <div>
                        <div class="activity-text">@Model.TotalUsers kayıtlı kullanıcı mevcut</div>
                        <div class="activity-time">@Model.ActiveUsers aktif, @(Model.TotalUsers - Model.ActiveUsers) pasif</div>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-dot blue"></div>
                    <div>
                        <div class="activity-text">@Model.TotalRoles rol tanımlanmış</div>
                        <div class="activity-time">Kullanıcılara atanabilir</div>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-dot"></div>
                    <div>
                        <div class="activity-text">Profil bilgilerinizi güncelleyin</div>
                        <div class="activity-time"><a href="/Profile">Profilime Git →</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
