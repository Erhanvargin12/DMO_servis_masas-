@{
    ViewData["Title"] = "Gizlilik";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Gizlilik Politikası</h3>
    </div>
    <div class="card-body" style="max-width: 720px;">
        <section style="margin-bottom: 32px;">
            <h4 style="font-size: 15px; font-weight: 600; margin-bottom: 12px;">Veri Toplama</h4>
            <p style="color: var(--text-secondary); font-size: 14px; line-height: 1.7;">
                KIP, yalnızca sistemin çalışması için gerekli olan verileri toplar.
                Toplanan veriler kullanıcı deneyimini iyileştirmek amacıyla kullanılır.
            </p>
        </section>
        
        <section style="margin-bottom: 32px;">
            <h4 style="font-size: 15px; font-weight: 600; margin-bottom: 12px;">Güvenlik</h4>
            <p style="color: var(--text-secondary); font-size: 14px; line-height: 1.7;">
                Tüm veriler endüstri standardı şifreleme ile korunur. 
                Şifreler HMAC-SHA512 algoritması ile hash'lenir.
            </p>
        </section>
        
        <section>
            <h4 style="font-size: 15px; font-weight: 600; margin-bottom: 12px;">Çerezler</h4>
            <p style="color: var(--text-secondary); font-size: 14px; line-height: 1.7;">
                Oturum yönetimi için zorunlu çerezler kullanılmaktadır.
            </p>
        </section>
    </div>
</div>
