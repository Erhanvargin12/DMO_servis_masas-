@model WebUI.Controllers.MenuListViewModel
@{
    ViewData["Title"] = "Menüler";
    var parentMenus = Model.Menus.Where(m => m.ParentId == null).OrderBy(m => m.DisplayOrder).ToList();
    var orphans = Model.Menus.Where(m => m.ParentId != null && !parentMenus.Any(p => p.Id == m.ParentId)).ToList();
}

<!-- Page Header -->
<div class="mgmt-page-header">
    <div class="mgmt-page-header-left">
        <div class="mgmt-page-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </div>
        <div>
            <div class="mgmt-page-title">Menü Yönetimi</div>
            <div class="mgmt-page-subtitle">Sistem menülerini düzenleyin ve rollere atayın</div>
        </div>
    </div>
    <button type="button" class="btn btn-primary" data-modal-open="menuModal">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Yeni Menü
    </button>
</div>

<!-- Data Table -->
<div class="data-table">
    <div class="data-table-header">
        <div class="data-table-title">
            <span>Menü Listesi</span>
            <span class="stat-chip">@Model.TotalCount kayıt</span>
        </div>
        <div class="data-table-actions">
            <div class="data-table-search">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" placeholder="Menü ara..." id="tableSearch" autocomplete="off" />
            </div>
        </div>
    </div>

    <div class="table-container">
        <table class="table mgmt-table" id="menusTable">
            <thead>
                <tr>
                    <th width="35%">Menü Adı</th>
                    <th width="20%">URL</th>
                    <th width="10%">İkon</th>
                    <th width="8%">Sıra</th>
                    <th width="10%">Durum</th>
                    <th width="17%"></th>
                </tr>
            </thead>
            <tbody>
                @if (parentMenus.Any() || orphans.Any())
                {
                    @foreach (var parent in parentMenus)
                    {
                        var children = Model.Menus.Where(m => m.ParentId == parent.Id).OrderBy(m => m.DisplayOrder).ToList();
                        var hasChildren = children.Any();

                        <tr class="menu-row-parent @(hasChildren ? "has-children" : "")"
                            data-item-id="@parent.Id"
                            data-parent="true"
                            data-group-id="group-@parent.Id"
                            data-item='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(parent, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null }))'>
                            <td>
                                <div class="entity-cell">
                                    @if (hasChildren)
                                    {
                                        <button type="button" class="tree-toggle-btn menu-tree-toggle" data-group="group-@parent.Id" title="Alt menüleri göster/gizle">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="width:22px;display:inline-block;flex-shrink:0;"></span>
                                    }
                                    <div class="entity-badge entity-badge-menu">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                                        </svg>
                                    </div>
                                    <div class="entity-info">
                                        <span class="entity-name">@parent.Name</span>
                                        @if (!string.IsNullOrEmpty(parent.Description))
                                        {
                                            <span class="entity-meta">@parent.Description</span>
                                        }
                                    </div>
                                    @if (hasChildren)
                                    {
                                        <span class="child-count-badge">@children.Count alt</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(parent.Url))
                                {
                                    <span class="entity-url">@parent.Url</span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(parent.Icon))
                                {
                                    <span class="badge badge-info">@parent.Icon</span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="text-center"><span class="entity-id">@parent.DisplayOrder</span></td>
                            <td>
                                <span class="badge @(parent.IsActive ? "badge-success" : "badge-error")">
                                    @(parent.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Rol Ata"
                                            data-role-modal="@parent.Id" data-menu-name="@parent.Name">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Düzenle"
                                            data-modal-open="menuModal" data-item-id="@parent.Id">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm btn-icon-danger" title="Sil"
                                            data-delete="@parent.Id" data-delete-name="@parent.Name">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>

                        @foreach (var child in children)
                        {
                            var isLast = child == children.Last();
                            <tr class="menu-row-child"
                                data-item-id="@child.Id"
                                data-child="true"
                                data-group="group-@parent.Id"
                                data-item='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(child, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null }))'>
                                <td>
                                    <div class="entity-cell" style="padding-left: 30px;">
                                        <span class="tree-connector @(isLast ? "last" : "")"></span>
                                        <div class="entity-badge entity-badge-menu-child">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
                                                <polyline points="13 2 13 9 20 9"/>
                                            </svg>
                                        </div>
                                        <div class="entity-info">
                                            <span class="entity-name" style="font-weight:400;color:var(--text-secondary);">@child.Name</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(child.Url))
                                    {
                                        <span class="entity-url">@child.Url</span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(child.Icon))
                                    {
                                        <span class="badge badge-info">@child.Icon</span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td class="text-center"><span class="entity-id">@child.DisplayOrder</span></td>
                                <td>
                                    <span class="badge @(child.IsActive ? "badge-success" : "badge-error")">
                                        @(child.IsActive ? "Aktif" : "Pasif")
                                    </span>
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Rol Ata"
                                                data-role-modal="@child.Id" data-menu-name="@child.Name">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                        </button>
                                        <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Düzenle"
                                                data-modal-open="menuModal" data-item-id="@child.Id">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        </button>
                                        <button type="button" class="btn btn-icon btn-ghost btn-sm btn-icon-danger" title="Sil"
                                                data-delete="@child.Id" data-delete-name="@child.Name">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    @foreach (var orphan in orphans)
                    {
                        <tr data-item-id="@orphan.Id"
                            data-item='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(orphan, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null }))'>
                            <td>
                                <div class="entity-cell">
                                    <div class="entity-badge entity-badge-menu-child">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                                    </div>
                                    <div class="entity-info">
                                        <span class="entity-name">@orphan.Name</span>
                                    </div>
                                    <span class="badge badge-warning" style="margin-left:6px;font-size:10px;">Üst menü yok</span>
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(orphan.Url))
                                {
                                    <span class="entity-url">@orphan.Url</span>
                                }
                            </td>
                            <td><span class="text-muted">—</span></td>
                            <td class="text-center"><span class="entity-id">@orphan.DisplayOrder</span></td>
                            <td><span class="badge @(orphan.IsActive ? "badge-success" : "badge-error")">@(orphan.IsActive ? "Aktif" : "Pasif")</span></td>
                            <td>
                                <div class="table-actions">
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Düzenle"
                                            data-modal-open="menuModal" data-item-id="@orphan.Id">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm btn-icon-danger" title="Sil"
                                            data-delete="@orphan.Id" data-delete-name="@orphan.Name">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="mgmt-empty">
                                <div class="mgmt-empty-icon">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
                                    </svg>
                                </div>
                                <p class="mgmt-empty-title">Menü bulunamadı</p>
                                <p class="mgmt-empty-text">Yeni menü eklemek için butonu kullanın</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="data-table-footer">
        <div class="data-table-info" id="paginationInfo">Toplam @Model.TotalCount menü</div>
        <div class="data-table-pagination" id="pagination"></div>
    </div>
</div>

<!-- Menu Modal -->
<div class="modal-overlay" id="menuModal">
    <div class="modal modal-md">
        <div class="modal-header">
            <h3 class="modal-title" data-create-title="Yeni Menü Ekle" data-edit-title="Menü Düzenle">Yeni Menü Ekle</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-controller="Menus" asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="0" />
            <div class="modal-body">
                <div class="form-section-title">Menü Bilgileri</div>
                <div class="form-row">
                    <div class="form-group" style="flex: 2;">
                        <label class="form-label required">Menü Adı</label>
                        <input type="text" name="Name" class="form-input" placeholder="Örn: Kullanıcılar" required />
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">Sıra</label>
                        <input type="number" name="DisplayOrder" class="form-input" value="0" min="0" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Grup Başlığı <span style="font-weight:400;color:var(--text-muted)">(sadece üst menüler için)</span></label>
                    <input type="text" name="Description" class="form-input" placeholder="Örn: Yönetim, Sistem" />
                </div>
                <div class="form-section-title" style="margin-top:16px;">Navigasyon</div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">URL</label>
                        <input type="text" name="Url" class="form-input" placeholder="/controller/action" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">İkon</label>
                        <select name="Icon" class="form-input">
                            <option value="">Seçiniz</option>
                            <option value="dashboard">📊 Dashboard</option>
                            <option value="users">👥 Kullanıcılar</option>
                            <option value="roles">🛡️ Roller</option>
                            <option value="menu">☰ Menü</option>
                            <option value="settings">⚙️ Ayarlar</option>
                            <option value="logs">📋 Loglar</option>
                            <option value="folder">📁 Klasör</option>
                            <option value="organization">🏢 Organizasyon</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Üst Menü</label>
                        <select name="ParentId" class="form-input">
                            <option value="0">— Ana Kategori —</option>
                            @foreach (var parent in parentMenus)
                            {
                                <option value="@parent.Id">@parent.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Durum</label>
                        <div class="form-check" style="margin-top: 8px;">
                            <input type="checkbox" name="IsActive" value="true" class="form-checkbox" id="menuIsActive" checked />
                            <label for="menuIsActive">Aktif</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary" data-create-text="Kaydet" data-edit-text="Güncelle">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<!-- Roles Modal -->
<div class="modal-overlay" id="rolesModal">
    <div class="modal modal-sm modal-tall">
        <div class="modal-header">
            <h3 class="modal-title">Menü Yetkileri</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <div class="modal-body">
            <div class="assign-entity-info">
                <div class="assign-entity-badge" id="roleMenuIcon">M</div>
                <div>
                    <div class="assign-entity-name" id="roleMenuName">Menü Adı</div>
                    <div class="assign-help-text">Bu menüyü görebilecek rolleri seçin</div>
                </div>
            </div>
            <div class="role-list" id="roleList">
                @foreach (var role in Model.Roles)
                {
                    <label class="role-item">
                        <input type="checkbox" class="role-checkbox" value="@role.Id" />
                        <div class="role-info">
                            <span class="role-name">@role.Name</span>
                            @if (!string.IsNullOrEmpty(role.Description))
                            {
                                <span class="role-desc">@role.Description</span>
                            }
                        </div>
                    </label>
                }
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn" data-modal-close>İptal</button>
            <button type="button" class="btn btn-primary" id="saveRolesBtn">Kaydet</button>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal modal-xs modal-compact">
        <div class="modal-header">
            <h3 class="modal-title">Silme Onayı</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-controller="Menus" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteModalItemId" value="" />
            <div class="modal-body">
                <div class="delete-confirm">
                    <div class="delete-confirm-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                        </svg>
                    </div>
                    <p class="delete-confirm-title">Silmek istediğinize emin misiniz?</p>
                    <p class="delete-confirm-name" id="deleteModalItemName"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>Vazgeç</button>
                <button type="submit" class="btn btn-danger">Sil</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/menus.js" asp-append-version="true"></script>
}
