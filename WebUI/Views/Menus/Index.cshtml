@using WebUI.Models
@using WebUI.Models.ViewModels
@model MenuViewModel
@{
    ViewData["Title"] = "Menüler";
}

<div class="mgmt-page-header">
    <div class="mgmt-page-header-left">
        <div class="mgmt-page-icon">
            <i class="fa-solid fa-bars"></i>
        </div>
        <div>
            <div class="mgmt-page-title">Menü Yönetimi</div>
            <div class="mgmt-page-subtitle">Sistem menülerini düzenleyin ve rollere atayın</div>
        </div>
    </div>
    <button type="button" class="btn btn-primary" data-modal-open="menuModal">
        <i class="fa-solid fa-plus"></i>
        Yeni Menü
    </button>
</div>

<!-- Filtre Çubuğu -->
<div class="data-table" style="margin-bottom:16px;">
    <div class="filter-wrap">
        <div class="filter-form">
            <div class="filter-row">
                <div class="data-table-search filter-search">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input type="text" placeholder="Menü ara..." id="tableSearch" autocomplete="off" />
                </div>
            </div>
        </div>
    </div>
</div>

<div class="data-table">
    <div class="data-table-header">
        <div class="data-table-title">
            <span>Menü Listesi</span>
            <span class="stat-chip"></span>
        </div>
        <div class="data-table-actions"></div>
    </div>

    <div class="table-container">
        <table class="table mgmt-table" data-paginate data-page-size="10">
            <thead>
                <tr>
                    <th>Menü Adı</th>
                    <th class="col-hide-md">URL</th>
                    <th class="col-hide-md">İkon</th>
                    <th class="col-hide-md">Sıra</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Menu.Any() || Model.Orphans.Any())
                {
                    @foreach (var parent in Model.Menu)
                    {
                        var hasChildren = parent.Childrens.Any();

                        <tr class="menu-row-parent @(hasChildren ? "has-children" : "")"
                            data-item-id="@parent.Parent.Id"
                            data-parent="true"
                            data-group-id="group-@parent.Parent.Id"
                            data-role-ids='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(parent.Claims.Select(c => c.OperationClaimId)))'
                            data-item='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(parent.Parent, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null }))'>
                            <td data-label="Menü Adı">
                                <div class="entity-cell">
                                    @if (hasChildren)
                                    {
                                        <button type="button" class="tree-toggle-btn menu-tree-toggle" data-group="group-@parent.Parent.Id" title="Alt menüleri göster/gizle">
                                            <i class="fa-solid fa-chevron-down"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="width:22px;display:inline-block;flex-shrink:0;"></span>
                                    }
                                    <div class="entity-badge entity-badge-menu">
                                        <i class="fa-solid fa-folder"></i>
                                    </div>
                                    <div class="entity-info">
                                        <span class="entity-name">@parent.Parent.Name</span>
                                        @if (!string.IsNullOrEmpty(parent.Parent.Description))
                                        {
                                            <span class="entity-meta">@parent.Parent.Description</span>
                                        }
                                    </div>
                                    @if (hasChildren)
                                    {
                                        <span class="child-count-badge">@parent.Childrens.Count alt</span>
                                    }
                                </div>
                            </td>
                            <td class="col-hide-md">
                                @if (!string.IsNullOrEmpty(parent.Parent.Url))
                                {
                                    <span class="entity-url">@parent.Parent.Url</span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="col-hide-md">
                                @if (!string.IsNullOrEmpty(parent.Parent.Icon))
                                {
                                    <span class="badge badge-info">@parent.Parent.Icon</span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="text-center col-hide-md"><span class="entity-id">@parent.Parent.DisplayOrder</span></td>
                            <td data-label="Durum">
                                <span class="badge @(parent.Parent.IsActive ? "badge-success" : "badge-error")">
                                    @(parent.Parent.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Rol Ata" data-assign-roles data-item-id="@parent.Parent.Id">
                                        <i class="fa-solid fa-shield-halved"></i>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Düzenle"
                                            data-modal-open="menuModal" data-item-id="@parent.Parent.Id">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm btn-icon-danger" title="Sil"
                                            data-delete="@parent.Parent.Id" data-delete-name="@parent.Parent.Name">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>

                        @foreach (var child in parent.Childrens)
                        {
                            var isLast = child == parent.Childrens.Last();
                            <tr class="menu-row-child"
                                data-item-id="@child.Children.Id"
                                data-child="true"
                                data-group="group-@parent.Parent.Id"
                                data-role-ids='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(child.Claims.Select(c=>c.OperationClaimId)))'
                                data-item='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(child.Children, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null }))'>
                                <td data-label="Menü Adı">
                                    <div class="entity-cell" style="padding-left: 30px;">
                                        <span class="tree-connector @(isLast ? "last" : "")"></span>
                                        <div class="entity-badge entity-badge-menu-child">
                                            <i class="fa-solid fa-file"></i>
                                        </div>
                                        <div class="entity-info">
                                            <span class="entity-name" style="font-weight:400;color:var(--text-secondary);">@child.Children.Name</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="col-hide-md">
                                    @if (!string.IsNullOrEmpty(child.Children.Url))
                                    {
                                        <span class="entity-url">@child.Children.Url</span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td class="col-hide-md">
                                    @if (!string.IsNullOrEmpty(child.Children.Icon))
                                    {
                                        <span class="badge badge-info">@child.Children.Icon</span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td class="text-center col-hide-md"><span class="entity-id">@child.Children.DisplayOrder</span></td>
                                <td data-label="Durum">
                                    <span class="badge @(child.Children.IsActive ? "badge-success" : "badge-error")">
                                        @(child.Children.IsActive ? "Aktif" : "Pasif")
                                    </span>
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Rol Ata"
                                                data-assign-roles data-item-id="@child.Children.Id">
                                            <i class="fa-solid fa-shield-halved"></i>
                                        </button>
                                        <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Düzenle"
                                                data-modal-open="menuModal" data-item-id="@child.Children.Id">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <button type="button" class="btn btn-icon btn-ghost btn-sm btn-icon-danger" title="Sil"
                                                data-delete="@child.Children.Id" data-delete-name="@child.Children.Name">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="mgmt-empty">
                                <div class="mgmt-empty-icon">
                                    <i class="fa-solid fa-bars"></i>
                                </div>
                                <p class="mgmt-empty-title">Menü bulunamadı</p>
                                <p class="mgmt-empty-text">Yeni menü eklemek için butonu kullanın</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="data-table-footer">
        <div class="data-table-info"></div>
    </div>
</div>

<!-- Menu Modal -->
<div class="modal-overlay" id="menuModal">
    <div class="modal modal-md">
        <div class="modal-header">
            <h3 class="modal-title" data-create-title="Yeni Menü Ekle" data-edit-title="Menü Düzenle">Yeni Menü Ekle</h3>
            <button type="button" class="modal-close" data-modal-close>
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form asp-controller="Menus" asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="0" />
            <div class="modal-body">
                <div class="form-section-title">Menü Bilgileri</div>
                <div class="form-row">
                    <div class="form-group" style="flex: 2;">
                        <label class="form-label required">Menü Adı</label>
                        <input type="text" name="Name" class="form-input" placeholder="Örn: Kullanıcılar" required />
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">Sıra</label>
                        <input type="number" name="DisplayOrder" class="form-input" value="0" min="0" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Grup Başlığı <span style="font-weight:400;color:var(--text-muted)">(sadece üst menüler için)</span></label>
                    <input type="text" name="Description" class="form-input" placeholder="Örn: Yönetim, Sistem" />
                </div>
                <div class="form-section-title" style="margin-top:16px;">Navigasyon</div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">URL</label>
                        <input type="text" name="Url" class="form-input" placeholder="/controller/action" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">İkon</label>
                        <select name="Icon" class="form-input">
                            <option value="">Seçiniz</option>
                            <option value="dashboard">Dashboard</option>
                            <option value="users">Kullanıcılar</option>
                            <option value="roles">Roller</option>
                            <option value="menu">Menü</option>
                            <option value="settings">Ayarlar</option>
                            <option value="logs">Loglar</option>
                            <option value="folder">Klasör</option>
                            <option value="organization">Organizasyon</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Üst Menü</label>
                        <select name="ParentId" class="form-input">
                            <option value="">— Ana Kategori —</option>
                            @foreach (var parent in Model.Menu)
                            {
                                <option value="@parent.Parent.Id">@parent.Parent.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Durum</label>
                        <div class="form-check" style="margin-top: 8px;">
                            <input type="checkbox" name="IsActive" value="true" class="form-checkbox" id="menuIsActive" checked />
                            <label for="menuIsActive">Aktif</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary" data-create-text="Kaydet" data-edit-text="Güncelle">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal modal-xs modal-compact">
        <div class="modal-header">
            <h3 class="modal-title">Silme Onayı</h3>
            <button type="button" class="modal-close" data-modal-close>
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form asp-controller="Menus" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteModalItemId" value="" />
            <div class="modal-body">
                <div class="delete-confirm">
                    <div class="delete-confirm-icon">
                        <i class="fa-solid fa-trash"></i>
                    </div>
                    <p class="delete-confirm-title">Silmek istediğinize emin misiniz?</p>
                    <p class="delete-confirm-name" id="deleteModalItemName"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>Vazgeç</button>
                <button type="submit" class="btn btn-danger">Sil</button>
            </div>
        </form>
    </div>
</div>

<!-- Roles Modal -->
<div class="modal-overlay" id="rolesModal">
    <div class="modal modal-sm">
        <div class="modal-header">
            <h3 class="modal-title">Rol Ata</h3>
            <button type="button" class="modal-close" data-modal-close>
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form asp-controller="Menus" asp-action="AssignRoles" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="menuId" id="rolesModalMenuId" value="0" />
            <div class="modal-body">
                <div class="assign-entity-info" style="margin-bottom:16px;">
                    <div class="assign-entity-badge" id="rolesModalBadge">
                        <i class="fa-solid fa-bars"></i>
                    </div>
                    <div>
                        <div class="assign-entity-name" id="rolesModalName">—</div>
                        <div class="assign-help-text" id="rolesModalMeta">—</div>
                    </div>
                </div>
                @if (Model.Roles.Any())
                {
                    <div class="assign-help-text" style="margin-bottom:10px;">Bu menüye erişim izni verilecek rolleri seçin:</div>
                    <div class="role-list">
                        @foreach (var role in Model.Roles)
                        {
                            <label class="role-item">
                                <input type="checkbox" class="role-checkbox" name="selectedRoleIds" value="@role.Id" />
                                <div class="role-info">
                                    <span class="role-name">@role.Name</span>
                                    @if (!string.IsNullOrEmpty(role.Description))
                                    {
                                        <span class="role-desc">@role.Description</span>
                                    }
                                </div>
                            </label>
                        }
                    </div>
                }
                else
                {
                    <div class="mgmt-empty"><p class="mgmt-empty-title">Sistemde rol bulunamadı</p></div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i>
                    Rolleri Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/menus.js" asp-append-version="true"></script>
}
