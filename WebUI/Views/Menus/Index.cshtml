@model WebUI.Controllers.MenuListViewModel
@{
    ViewData["Title"] = "Menüler";
    var parentMenus = Model.Menus.Where(m => m.ParentId == null).OrderBy(m => m.DisplayOrder).ToList();
    
    // Menüleri hiyerarşik sırala
    var orderedMenus = new List<WebUI.Models.MenuViewModel>();
    foreach (var parent in parentMenus)
    {
        orderedMenus.Add(parent);
        var children = Model.Menus.Where(m => m.ParentId == parent.Id).OrderBy(m => m.DisplayOrder).ToList();
        orderedMenus.AddRange(children);
    }
    // Üst menüsü olmayan alt menüler
    var orphans = Model.Menus.Where(m => m.ParentId != null && !parentMenus.Any(p => p.Id == m.ParentId)).ToList();
    orderedMenus.AddRange(orphans);
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-header-title">Menü Yönetimi</h1>
        <p class="page-header-subtitle">Sistem menülerini düzenleyin ve rollere atayın</p>
    </div>
    <button type="button" class="btn btn-primary" data-modal-open="menuModal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Yeni Menü
    </button>
</div>

<!-- Data Table -->
<div class="data-table">
    <div class="data-table-header">
        <div class="data-table-title">
            <span>Menü Listesi</span>
            <span class="data-table-count">@Model.TotalCount kayıt</span>
        </div>
        <div class="data-table-actions">
            <div class="data-table-search">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" placeholder="Menü ara..." id="tableSearch" autocomplete="off" />
            </div>
        </div>
    </div>

    <div class="table-container">
        <table class="table" id="menusTable">
            <thead>
                <tr>
                    <th width="35%">Menü Adı</th>
                    <th width="20%">URL</th>
                    <th width="10%">İkon</th>
                    <th width="8%">Sıra</th>
                    <th width="10%">Durum</th>
                    <th width="17%"></th>
                </tr>
            </thead>
            <tbody>
                @if (orderedMenus.Any())
                {
                    @foreach (var menu in orderedMenus)
                    {
                        var isParent = menu.ParentId == null;
                        
                        <tr data-item-id="@menu.Id" 
                            data-parent="@(isParent ? "true" : "false")"
                            data-child="@(!isParent ? "true" : "false")"
                            data-item='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(menu, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null }))'>
                            <td>
                                <div class="menu-name-cell">
                                    @if (!isParent)
                                    {
                                        <span class="menu-indent">└</span>
                                    }
                                    <span class="@(isParent ? "menu-parent" : "menu-child")">@menu.Name</span>
                                    @if (!string.IsNullOrEmpty(menu.Description))
                                    {
                                        <span class="menu-desc">@menu.Description</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(menu.Url))
                                {
                                    <code class="url-code">@menu.Url</code>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(menu.Icon))
                                {
                                    <span class="badge badge-info">@menu.Icon</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">@menu.DisplayOrder</td>
                            <td>
                                <span class="badge @(menu.IsActive ? "badge-success" : "badge-error")">
                                    @(menu.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Roller"
                                            data-role-modal="@menu.Id" data-menu-name="@menu.Name">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                        </svg>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Düzenle"
                                            data-modal-open="menuModal" data-item-id="@menu.Id">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm btn-icon-danger" title="Sil"
                                            data-delete="@menu.Id" data-delete-name="@menu.Name">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6"/>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="empty-row">
                        <td colspan="6" class="empty-state">
                            <div class="empty-state-icon">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <line x1="3" y1="12" x2="21" y2="12"/>
                                    <line x1="3" y1="6" x2="21" y2="6"/>
                                    <line x1="3" y1="18" x2="21" y2="18"/>
                                </svg>
                            </div>
                            <p class="empty-state-title">Menü bulunamadı</p>
                            <p class="empty-state-text">Yeni menü eklemek için butonu kullanın</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="data-table-footer">
        <div class="data-table-info" id="paginationInfo">Toplam @Model.TotalCount menü</div>
        <div class="data-table-pagination" id="pagination"></div>
    </div>
</div>

<!-- Menu Modal - Yatay form düzeni -->
<div class="modal-overlay" id="menuModal">
    <div class="modal modal-md">
        <div class="modal-header">
            <h3 class="modal-title" data-create-title="Yeni Menü Ekle" data-edit-title="Menü Düzenle">Yeni Menü Ekle</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form class="ajax-form" asp-controller="Menus" asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="0" />
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group" style="flex: 2;">
                        <label class="form-label required">Menü Adı</label>
                        <input type="text" name="Name" class="form-input" placeholder="Örn: Kullanıcılar" required />
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">Sıra</label>
                        <input type="number" name="DisplayOrder" class="form-input" value="0" min="0" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Grup Başlığı</label>
                    <input type="text" name="Description" class="form-input" placeholder="Örn: Yönetim, Sistem (sadece üst menüler için)" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">URL</label>
                        <input type="text" name="Url" class="form-input" placeholder="/controller/action" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">İkon</label>
                        <select name="Icon" class="form-input">
                            <option value="">Seçiniz</option>
                            <option value="dashboard">📊 Dashboard</option>
                            <option value="users">👥 Kullanıcılar</option>
                            <option value="roles">🛡️ Roller</option>
                            <option value="menu">☰ Menü</option>
                            <option value="settings">⚙️ Ayarlar</option>
                            <option value="logs">📋 Loglar</option>
                            <option value="folder">📁 Klasör</option>
                            <option value="organization">🏢 Organizasyon</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Üst Menü</label>
                        <select name="ParentId" class="form-input">
                            <option value="0">Ana Kategori</option>
                            @foreach (var parent in parentMenus)
                            {
                                <option value="@parent.Id">@parent.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Durum</label>
                        <div class="form-check" style="margin-top: 8px;">
                            <input type="checkbox" name="IsActive" class="form-checkbox" id="menuIsActive" checked />
                            <label for="menuIsActive">Aktif</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary" data-create-text="Kaydet" data-edit-text="Güncelle">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<!-- Roles Modal - Uzun liste için -->
<div class="modal-overlay" id="rolesModal">
    <div class="modal modal-sm modal-tall">
        <div class="modal-header">
            <h3 class="modal-title">Menü Yetkileri</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <div class="modal-body">
            <div class="role-user-info">
                <div class="role-user-avatar" id="roleMenuIcon">M</div>
                <div class="role-user-name" id="roleMenuName">Menü Adı</div>
            </div>
            <p class="role-help-text">Bu menüyü görebilecek rolleri seçin:</p>
            <div class="role-list" id="roleList">
                @foreach (var role in Model.Roles)
                {
                    <label class="role-item">
                        <input type="checkbox" class="role-checkbox" value="@role.Id" />
                        <div class="role-info">
                            <span class="role-name">@role.Name</span>
                            @if (!string.IsNullOrEmpty(role.Description))
                            {
                                <span class="role-desc">@role.Description</span>
                            }
                        </div>
                    </label>
                }
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn" data-modal-close>İptal</button>
            <button type="button" class="btn btn-primary" id="saveRolesBtn">Kaydet</button>
        </div>
    </div>
</div>

<!-- Delete Modal - Küçük ve kompakt -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal modal-xs modal-compact">
        <div class="modal-header">
            <h3 class="modal-title">Silme Onayı</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-controller="Menus" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteModalItemId" value="" />
            <div class="modal-body">
                <div class="delete-content">
                    <div class="delete-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                        </svg>
                    </div>
                    <p class="delete-title">Silmek istediğinize emin misiniz?</p>
                    <p class="delete-name" id="deleteModalItemName"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>Vazgeç</button>
                <button type="submit" class="btn btn-danger">Sil</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/menus.js" asp-append-version="true"></script>
}
