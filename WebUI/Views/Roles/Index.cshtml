@model WebUI.Models.RoleListViewModel
@{
    ViewData["Title"] = "Roller";
}

<!-- Page Header -->
<div class="mgmt-page-header">
    <div class="mgmt-page-header-left">
        <div class="mgmt-page-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
        </div>
        <div>
            <div class="mgmt-page-title">Rol Yönetimi</div>
            <div class="mgmt-page-subtitle">Sistem rollerini yönetin ve kullanıcılara atayın</div>
        </div>
    </div>
    <button type="button" class="btn btn-primary" data-modal-open="roleModal">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Yeni Rol
    </button>
</div>

<!-- Data Table -->
<div class="data-table">
    <div class="data-table-header">
        <div class="data-table-title">
            <span>Rol Listesi</span>
            <span class="stat-chip">@Model.TotalCount kayıt</span>
        </div>
        <div class="data-table-actions">
            <!-- Server-side arama formu -->
            <form method="get" asp-action="Index" asp-controller="Roles" class="data-table-search">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" name="search" value="@Model.SearchTerm"
                       placeholder="Rol adı veya açıklama ara..."
                       autocomplete="off" />
            </form>
        </div>
    </div>

    <div class="table-container">
        <table class="table mgmt-table" id="rolesTable">
            <thead>
                <tr>
                    <th width="8%">ID</th>
                    <th width="35%">Rol Adı</th>
                    <th width="42%">Açıklama</th>
                    <th width="15%"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Roles.Any())
                {
                    @foreach (var role in Model.Roles)
                    {
                        <tr data-item-id="@role.Id"
                            data-item='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(role, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null }))'>
                            <td><span class="entity-id">#@role.Id</span></td>
                            <td>
                                <div class="entity-cell">
                                    <div class="entity-badge entity-badge-role">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                        </svg>
                                    </div>
                                    <div class="entity-info">
                                        <span class="entity-name">@role.Name</span>
                                    </div>
                                </div>
                            </td>
                            <td class="entity-desc">@(role.Description ?? "—")</td>
                            <td>
                                <div class="table-actions">
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Düzenle"
                                            data-modal-open="roleModal" data-item-id="@role.Id">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm btn-icon-danger" title="Sil"
                                            data-delete="@role.Id" data-delete-name="@role.Name">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6"/>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4">
                            <div class="mgmt-empty">
                                <div class="mgmt-empty-icon">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                    </svg>
                                </div>
                                <p class="mgmt-empty-title">
                                    @(string.IsNullOrEmpty(Model.SearchTerm) ? "Rol bulunamadı" : $"'{Model.SearchTerm}' için sonuç bulunamadı")
                                </p>
                                <p class="mgmt-empty-text">
                                    @(string.IsNullOrEmpty(Model.SearchTerm) ? "Yeni rol eklemek için butonu kullanın" : "Farklı bir arama terimi deneyin")
                                </p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Server-side Pagination -->
    <partial name="_Pagination" model="Model.ToPagination()" />
</div>

<!-- Role Modal (Ekle / Düzenle) -->
<div class="modal-overlay" id="roleModal">
    <div class="modal modal-sm">
        <div class="modal-header">
            <h3 class="modal-title"
                data-create-title="Yeni Rol Ekle"
                data-edit-title="Rol Düzenle">Yeni Rol Ekle</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-controller="Roles" asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="0" />
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label required">Rol Adı</label>
                    <input type="text" name="Name" class="form-input"
                           placeholder="Örn: Admin, Editor, Viewer" required />
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Açıklama</label>
                    <textarea name="Description" class="form-input form-textarea" rows="3"
                              placeholder="Rol açıklaması (isteğe bağlı)"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary"
                        data-create-text="Kaydet" data-edit-text="Güncelle">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal modal-xs modal-compact">
        <div class="modal-header">
            <h3 class="modal-title">Silme Onayı</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-controller="Roles" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteModalItemId" value="" />
            <div class="modal-body">
                <div class="delete-confirm">
                    <div class="delete-confirm-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                        </svg>
                    </div>
                    <p class="delete-confirm-title">Silmek istediğinize emin misiniz?</p>
                    <p class="delete-confirm-name" id="deleteModalItemName"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>Vazgeç</button>
                <button type="submit" class="btn btn-danger">Sil</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/roles.js" asp-append-version="true"></script>
}
