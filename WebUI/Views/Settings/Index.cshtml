@model WebUI.Models.SettingsViewModel
@{
    ViewData["Title"] = "Ayarlar";
}

<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-header-title">Sistem Ayarları</h1>
        <p class="page-header-subtitle">Uygulamayı kişiselleştirin ve tercihlerinizi yönetin</p>
    </div>
    <div class="page-header-actions">
        <button type="button" class="btn btn-ghost" id="resetSettingsBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
            Sıfırla
        </button>
        <button type="button" class="btn btn-primary" id="saveSettingsBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
            Kaydet
        </button>
    </div>
</div>

<div class="settings-container">
    <!-- Sol Nav -->
    <div class="settings-sidebar">
        <nav class="settings-nav">
            <button class="settings-nav-item active" data-tab="appearance">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path></svg>
                <span>Görünüm</span>
            </button>
            <button class="settings-nav-item" data-tab="theme">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                <span>Tema ve Renkler</span>
            </button>
            <button class="settings-nav-item" data-tab="typography">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                <span>Yazı Tipi</span>
            </button>
            <button class="settings-nav-item" data-tab="layout">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
                <span>Yerleşim</span>
            </button>
            <button class="settings-nav-item" data-tab="tables">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="3" y1="15" x2="21" y2="15"></line><line x1="9" y1="3" x2="9" y2="21"></line><line x1="15" y1="3" x2="15" y2="21"></line></svg>
                <span>Tablolar</span>
            </button>
            <button class="settings-nav-item" data-tab="notifications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                <span>Bildirimler</span>
            </button>
            <button class="settings-nav-item" data-tab="accessibility">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="10" r="3"></circle><path d="M7 20.662V19a5 5 0 0 1 10 0v1.662"></path></svg>
                <span>Erişilebilirlik</span>
            </button>
            <button class="settings-nav-item" data-tab="advanced">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg>
                <span>Gelişmiş</span>
            </button>
        </nav>
    </div>

    <div class="settings-content">

        <!-- ═══ GÖRÜNÜM ═══════════════════════════════════════════════════════ -->
        <div class="settings-tab active" id="appearance-tab">
            <div class="settings-section">
                <h2 class="settings-section-title">Genel Görünüm</h2>
                <div class="settings-group">
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Kompakt Mod</span>
                            <span class="setting-desc">Daha fazla içerik görmek için arayüzü sıkıştır</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="compactMode" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Animasyonlar</span>
                            <span class="setting-desc">Geçiş efektlerini etkinleştir</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="showAnimations" checked /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Köşe Yuvarlaklığı</span>
                            <span class="setting-desc">Arayüz elemanlarının köşe yarıçapı</span>
                        </div>
                        <div class="setting-control">
                            <input type="range" id="borderRadius" min="0" max="20" value="6" class="range-input" />
                            <span class="range-value">6px</span>
                        </div>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Gölge Yoğunluğu</span>
                            <span class="setting-desc">Kart ve panellerin gölge efekti</span>
                        </div>
                        <div class="setting-control">
                            <select id="shadowIntensity" class="form-select">
                                <option value="none">Gölge Yok</option>
                                <option value="light">Hafif</option>
                                <option value="medium" selected>Orta</option>
                                <option value="strong">Güçlü</option>
                            </select>
                        </div>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Üst Çubuk Stili</span>
                            <span class="setting-desc">Topbar görünüm şekli</span>
                        </div>
                        <div class="setting-control">
                            <select id="topbarStyle" class="form-select">
                                <option value="solid" selected>Düz</option>
                                <option value="glass">Cam (Frosted)</option>
                                <option value="minimal">Minimal (Kenarsız)</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ TEMA VE RENKLER ══════════════════════════════════════════════ -->
        <div class="settings-tab" id="theme-tab">
            <div class="settings-section">
                <h2 class="settings-section-title">Tema Seçimi</h2>
                <div class="theme-selector">
                    <label class="theme-option">
                        <input type="radio" name="theme" value="light" checked />
                        <div class="theme-preview theme-light">
                            <div class="theme-preview-header"></div>
                            <div class="theme-preview-content">
                                <div class="theme-preview-sidebar"></div>
                                <div class="theme-preview-main"></div>
                            </div>
                        </div>
                        <span>Açık</span>
                    </label>
                    <label class="theme-option">
                        <input type="radio" name="theme" value="dark" />
                        <div class="theme-preview theme-dark">
                            <div class="theme-preview-header"></div>
                            <div class="theme-preview-content">
                                <div class="theme-preview-sidebar"></div>
                                <div class="theme-preview-main"></div>
                            </div>
                        </div>
                        <span>Koyu</span>
                    </label>
                    <label class="theme-option">
                        <input type="radio" name="theme" value="auto" />
                        <div class="theme-preview theme-auto">
                            <div class="theme-preview-half-light">
                                <div class="theme-preview-header"></div>
                                <div class="theme-preview-content">
                                    <div class="theme-preview-sidebar"></div>
                                    <div class="theme-preview-main"></div>
                                </div>
                            </div>
                            <div class="theme-preview-half-dark">
                                <div class="theme-preview-header"></div>
                                <div class="theme-preview-content">
                                    <div class="theme-preview-sidebar"></div>
                                    <div class="theme-preview-main"></div>
                                </div>
                            </div>
                        </div>
                        <span>Otomatik</span>
                    </label>
                </div>
            </div>

            <div class="settings-section">
                <h2 class="settings-section-title">Renk Paleti</h2>
                <div class="color-presets">
                    <button class="color-preset active" data-preset="default">
                        <div class="color-preset-preview">
                            <span style="background:#0ea5e9"></span>
                            <span style="background:#0f172a"></span>
                            <span style="background:#f8fafc"></span>
                        </div>
                        <span>Varsayılan</span>
                    </button>
                    <button class="color-preset" data-preset="aurora">
                        <div class="color-preset-preview">
                            <span style="background:#8b5cf6"></span>
                            <span style="background:#0b1021"></span>
                            <span style="background:#f5f3ff"></span>
                        </div>
                        <span>Aurora</span>
                    </button>
                    <button class="color-preset" data-preset="emerald">
                        <div class="color-preset-preview">
                            <span style="background:#22c55e"></span>
                            <span style="background:#0f1f17"></span>
                            <span style="background:#f1f5f3"></span>
                        </div>
                        <span>Emerald</span>
                    </button>
                    <button class="color-preset" data-preset="sunrise">
                        <div class="color-preset-preview">
                            <span style="background:#f97316"></span>
                            <span style="background:#31102b"></span>
                            <span style="background:#fff7ed"></span>
                        </div>
                        <span>Sunrise</span>
                    </button>
                    <button class="color-preset" data-preset="ocean">
                        <div class="color-preset-preview">
                            <span style="background:#2563eb"></span>
                            <span style="background:#0b1a2e"></span>
                            <span style="background:#eaf2ff"></span>
                        </div>
                        <span>Ocean</span>
                    </button>
                    <button class="color-preset" data-preset="mono">
                        <div class="color-preset-preview">
                            <span style="background:#6b7280"></span>
                            <span style="background:#1f2937"></span>
                            <span style="background:#f6f7f9"></span>
                        </div>
                        <span>Mono</span>
                    </button>
                    <button class="color-preset" data-preset="rose">
                        <div class="color-preset-preview">
                            <span style="background:#f43f5e"></span>
                            <span style="background:#1f0a15"></span>
                            <span style="background:#fff1f2"></span>
                        </div>
                        <span>Rose</span>
                    </button>
                    <button class="color-preset" data-preset="custom">
                        <div class="color-preset-preview">
                            <span style="background:linear-gradient(135deg,#667eea,#764ba2)"></span>
                        </div>
                        <span>Özel</span>
                    </button>
                </div>

                <div class="custom-colors" style="display:none;">
                    <div class="color-row">
                        <div class="color-item">
                            <label>Ana Renk (Accent)</label>
                            <div class="color-input-group">
                                <input type="color" id="accentColor" value="#0ea5e9" />
                                <input type="text" value="#0ea5e9" class="color-text" />
                            </div>
                        </div>
                        <div class="color-item">
                            <label>Sidebar Rengi</label>
                            <div class="color-input-group">
                                <input type="color" id="sidebarColor" value="#0f172a" />
                                <input type="text" value="#0f172a" class="color-text" />
                            </div>
                        </div>
                    </div>
                    <div class="color-row">
                        <div class="color-item">
                            <label>Arka Plan</label>
                            <div class="color-input-group">
                                <input type="color" id="bgColor" value="#f8fafc" />
                                <input type="text" value="#f8fafc" class="color-text" />
                            </div>
                        </div>
                        <div class="color-item">
                            <label>Kart Rengi</label>
                            <div class="color-input-group">
                                <input type="color" id="cardColor" value="#ffffff" />
                                <input type="text" value="#ffffff" class="color-text" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ YAZI TİPİ ════════════════════════════════════════════════════ -->
        <div class="settings-tab" id="typography-tab">
            <div class="settings-section">
                <h2 class="settings-section-title">Yazı Tipi Ayarları</h2>
                <div class="settings-group">
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Yazı Tipi Ailesi</span>
                            <span class="setting-desc">Uygulama genelinde kullanılacak yazı tipi</span>
                        </div>
                        <div class="setting-control">
                            <select id="fontFamily" class="form-select">
                                <option value="system">Sistem Varsayılanı</option>
                                <option value="inter">Inter</option>
                                <option value="roboto">Roboto</option>
                                <option value="poppins">Poppins</option>
                                <option value="montserrat">Montserrat</option>
                                <option value="nunito">Nunito</option>
                                <option value="opensans">Open Sans</option>
                            </select>
                        </div>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Yazı Boyutu</span>
                            <span class="setting-desc">Temel yazı boyutu (12–18px)</span>
                        </div>
                        <div class="setting-control">
                            <input type="range" id="fontSize" min="12" max="18" value="14" class="range-input" />
                            <span class="range-value">14px</span>
                        </div>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Satır Aralığı</span>
                            <span class="setting-desc">Metin satırları arası boşluk</span>
                        </div>
                        <div class="setting-control">
                            <select id="lineHeight" class="form-select">
                                <option value="1.3">Sıkışık (1.3)</option>
                                <option value="1.5" selected>Normal (1.5)</option>
                                <option value="1.7">Geniş (1.7)</option>
                                <option value="2">Çok Geniş (2.0)</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="settings-section">
                <h2 class="settings-section-title">Önizleme</h2>
                <div class="font-preview">
                    <h1>Başlık Örneği — Abc 123</h1>
                    <p>Normal metin. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Arayüz metinleri bu şekilde görünür.</p>
                    <small>Küçük etiket metni — versiyon 1.0</small>
                </div>
            </div>
        </div>

        <!-- ═══ YERLEŞİM ═════════════════════════════════════════════════════ -->
        <div class="settings-tab" id="layout-tab">
            <div class="settings-section">
                <h2 class="settings-section-title">Sidebar</h2>
                <div class="settings-group">
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Sidebar Genişliği</span>
                            <span class="setting-desc">Sol menü genişliği (200–300px)</span>
                        </div>
                        <div class="setting-control">
                            <input type="range" id="sidebarWidth" min="200" max="300" value="240" step="10" class="range-input" />
                            <span class="range-value">240px</span>
                        </div>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Sidebar Renk Stili</span>
                            <span class="setting-desc">Sidebar arka plan görünümü</span>
                        </div>
                        <div class="setting-control">
                            <select id="sidebarStyle" class="form-select">
                                <option value="dark" selected>Koyu</option>
                                <option value="light">Açık</option>
                                <option value="gradient">Gradient</option>
                                <option value="transparent">Şeffaf</option>
                            </select>
                        </div>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Menü Öğe Stili</span>
                            <span class="setting-desc">Menü linklerinin görünümü</span>
                        </div>
                        <div class="setting-control">
                            <select id="menuStyle" class="form-select">
                                <option value="default" selected>Varsayılan</option>
                                <option value="rounded">Yuvarlak Köşeli</option>
                                <option value="pills">Hap Şekli</option>
                                <option value="minimal">Minimal (Sadece Metin)</option>
                            </select>
                        </div>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Başlangıçta Kapalı</span>
                            <span class="setting-desc">Sayfa yüklendiğinde sidebar kapalı başlasın</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="sidebarCollapsed" /><span class="toggle-slider"></span></label>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ TABLOLAR ══════════════════════════════════════════════════════ -->
        <div class="settings-tab" id="tables-tab">
            <div class="settings-section">
                <h2 class="settings-section-title">Tablo Görünümü</h2>
                <div class="settings-group">
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Sayfa Başına Kayıt</span>
                            <span class="setting-desc">Tablolarda varsayılan satır sayısı</span>
                        </div>
                        <div class="setting-control">
                            <select id="pageSize" class="form-select">
                                <option value="5">5</option>
                                <option value="8">8</option>
                                <option value="10" selected>10</option>
                                <option value="15">15</option>
                                <option value="20">20</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                        </div>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Kompakt Tablolar</span>
                            <span class="setting-desc">Satır yüksekliğini küçült</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="compactTables" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Tablo Kenarlıkları</span>
                            <span class="setting-desc">Hücreler arası çizgileri göster</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="showTableBorders" checked /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Zebra Çizgiler</span>
                            <span class="setting-desc">Alternatif satır renklendirmesi</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="zebraStripes" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Satır Hover Vurgulama</span>
                            <span class="setting-desc">Fare üzerine gelince satırı vurgula</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="tableHoverRow" checked /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Yapışkan Tablo Başlığı</span>
                            <span class="setting-desc">Scroll'da tablo başlığı sabit kalsın</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="stickyTableHeader" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Satır Numaraları</span>
                            <span class="setting-desc">Tablolarda sıra numarası göster</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="tableRowNumbers" /><span class="toggle-slider"></span></label>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ BİLDİRİMLER ══════════════════════════════════════════════════ -->
        <div class="settings-tab" id="notifications-tab">
            <div class="settings-section">
                <h2 class="settings-section-title">Bildirim Ayarları</h2>
                <div class="settings-group">
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Bildirim Konumu</span>
                            <span class="setting-desc">Toast bildirimlerin ekrandaki pozisyonu</span>
                        </div>
                        <div class="setting-control">
                            <select id="toastPosition" class="form-select">
                                <option value="top-left">Sol Üst</option>
                                <option value="top-center">Orta Üst</option>
                                <option value="top-right" selected>Sağ Üst</option>
                                <option value="bottom-left">Sol Alt</option>
                                <option value="bottom-center">Orta Alt</option>
                                <option value="bottom-right">Sağ Alt</option>
                            </select>
                        </div>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Görüntülenme Süresi</span>
                            <span class="setting-desc">Bildirimin ekranda kalma süresi</span>
                        </div>
                        <div class="setting-control">
                            <input type="range" id="toastDuration" min="1000" max="10000" value="4000" step="500" class="range-input" />
                            <span class="range-value">4000ms</span>
                        </div>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Test Bildirimi</span>
                            <span class="setting-desc">Ayarların geçerli olduğunu test et</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary" id="testToastBtn">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                            Test Et
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ ERİŞİLEBİLİRLİK ══════════════════════════════════════════════ -->
        <div class="settings-tab" id="accessibility-tab">
            <div class="settings-section">
                <h2 class="settings-section-title">Erişilebilirlik Ayarları</h2>
                <div class="settings-group">
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Yüksek Kontrast</span>
                            <span class="setting-desc">Renk kontrastını artır</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="highContrast" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Azaltılmış Hareket</span>
                            <span class="setting-desc">Tüm animasyonları kapat</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="reducedMotion" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Büyük Metin</span>
                            <span class="setting-desc">Tüm yazıları büyüt (+2px)</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="largeText" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Odak Göstergesi</span>
                            <span class="setting-desc">Klavye navigasyonu için belirgin odak çerçevesi</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="focusIndicator" checked /><span class="toggle-slider"></span></label>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ GELİŞMİŞ ═════════════════════════════════════════════════════ -->
        <div class="settings-tab" id="advanced-tab">
            <div class="settings-section">
                <h2 class="settings-section-title">Davranış</h2>
                <div class="settings-group">
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Silme Onayı</span>
                            <span class="setting-desc">Kayıt silmeden önce onay penceresi göster</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="confirmDelete" checked /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Önbellek Kullan</span>
                            <span class="setting-desc">Daha hızlı yükleme için önbelleği etkinleştir</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="useCache" checked /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Lazy Loading</span>
                            <span class="setting-desc">İçerikleri gecikmeli yükle</span>
                        </div>
                        <label class="toggle"><input type="checkbox" id="lazyLoading" checked /><span class="toggle-slider"></span></label>
                    </div>
                </div>
            </div>

            <div class="settings-section">
                <h2 class="settings-section-title">Özel CSS</h2>
                <div class="settings-group">
                    <div class="setting-item" style="align-items:flex-start; flex-direction:column; gap:10px;">
                        <div class="setting-label">
                            <span class="setting-name">Özel Stil (CSS)</span>
                            <span class="setting-desc">İleri seviye: Kendi CSS kurallarınızı ekleyin. Kaydet'e bastığınızda anında uygulanır.</span>
                        </div>
                        <textarea id="customCss" class="custom-css-editor" placeholder="/* Örnek */&#10;.sidebar { border-right: 3px solid var(--accent); }&#10;.page-header { background: var(--accent-light); }"></textarea>
                    </div>
                </div>
            </div>

            <div class="settings-section">
                <h2 class="settings-section-title">Veri Yönetimi</h2>
                <div class="settings-group">
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Ayarları Dışa Aktar</span>
                            <span class="setting-desc">Mevcut ayarları JSON olarak indir</span>
                        </div>
                        <button type="button" class="btn btn-sm" id="exportSettingsBtn">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                            Dışa Aktar
                        </button>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Ayarları İçe Aktar</span>
                            <span class="setting-desc">JSON dosyasından ayarları yükle</span>
                        </div>
                        <input type="file" id="importSettings" accept=".json" style="display:none;" />
                        <button type="button" class="btn btn-sm" onclick="document.getElementById('importSettings').click()">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                            İçe Aktar
                        </button>
                    </div>
                    <div class="setting-item">
                        <div class="setting-label">
                            <span class="setting-name">Önbelleği Temizle</span>
                            <span class="setting-desc">Tarayıcı localStorage önbelleğini temizle</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-danger" id="clearCacheBtn">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            Temizle
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script src="~/js/pages/settings.js" asp-append-version="true"></script>
}
