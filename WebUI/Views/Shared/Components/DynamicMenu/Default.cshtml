@using WebUI.Models.ViewModels
@model MenuViewModel

@functions {
    string SafeUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "#";
        var cleanUrl = url.Trim();
        if (cleanUrl.StartsWith("http") || cleanUrl.StartsWith("#")) return cleanUrl;
        if (!cleanUrl.StartsWith("/")) cleanUrl = "/" + cleanUrl;

        if (cleanUrl.Contains("Rapor", StringComparison.OrdinalIgnoreCase) || cleanUrl.Contains("Report", StringComparison.OrdinalIgnoreCase) || cleanUrl.Contains("Export", StringComparison.OrdinalIgnoreCase))
            return "/Tickets/Report/Index";
        if (cleanUrl.Contains("Gorev", StringComparison.OrdinalIgnoreCase) || cleanUrl.Contains("Assigned", StringComparison.OrdinalIgnoreCase))
            return "/Tickets/Ticket/AssignedTickets";
        if (cleanUrl.Contains("Birim", StringComparison.OrdinalIgnoreCase))
            return "/Tickets/Ticket/BirimTalepleri";
        if (cleanUrl.Contains("Tamamlan", StringComparison.OrdinalIgnoreCase) || cleanUrl.Contains("Completed", StringComparison.OrdinalIgnoreCase) || cleanUrl.Contains("Closed", StringComparison.OrdinalIgnoreCase) || cleanUrl.Contains("Kapat", StringComparison.OrdinalIgnoreCase))
            return "/Tickets/Ticket/Completed";
        if (cleanUrl.EndsWith("/Talep", StringComparison.OrdinalIgnoreCase) || cleanUrl.EndsWith("/Taleplerim", StringComparison.OrdinalIgnoreCase) || cleanUrl.Contains("Index", StringComparison.OrdinalIgnoreCase))
            return "/Tickets/Ticket/Index";

        return cleanUrl;
    }

    string GetIcon(string? iconName)
    {
        var fa = iconName switch
        {
            "dashboard"    => "fa-table-cells-large",
            "users"        => "fa-users",
            "roles"        => "fa-shield-halved",
            "organization" => "fa-building",
            "settings"     => "fa-gear",
            "logs"         => "fa-file-lines",
            "menu"         => "fa-bars",
            "folder"       => "fa-folder",
            _              => "fa-circle"
        };
        return $"<i class=\"fa-solid {fa} menu-icon\"></i>";
    }
}

@if (Context.Session.GetString("UserType") == "Company" || User.IsInRole("SupplierCompany") || Context.Request.Path.Value?.Contains("Supplier", StringComparison.OrdinalIgnoreCase) == true)
{
    <a href="/Tickets/Supplier/Index" class="menu-link active">
        <i class="fa-solid fa-handshake-angle menu-icon" style="color:#10b981;"></i>
        <span class="menu-text" style="font-weight:700;">Tedarikçi Portalı</span>
    </a>
}
else if (Model != null && Model.Menu.Any())
{
    foreach (var menu in Model.Menu)
    {
        var hasChildren = menu.Childrens.Any();

        if (hasChildren)
        {
            <div class="menu-group">
                <a href="javascript:void(0)" class="menu-link has-submenu" data-toggle="submenu" data-menu-id="@menu.Parent.Id">
                    @Html.Raw(GetIcon(menu.Parent.Icon))
                    <span class="menu-text">@menu.Parent.Name</span>
                    <i class="fa-solid fa-chevron-down submenu-arrow"></i>
                </a>
                <div class="submenu" data-parent-menu-id="@menu.Parent.Id">
                    @foreach (var child in menu.Childrens!.OrderBy(c => c.Children.DisplayOrder))
                    {
                        <a href="@SafeUrl(child.Children.Url)" class="menu-link submenu-link">
                            @Html.Raw(GetIcon(child.Children.Icon))
                            <span class="menu-text">@child.Children.Name</span>
                        </a>
                    }
                    @if (menu.Parent.Name.Contains("Talep", StringComparison.OrdinalIgnoreCase))
                    {
                        var currentUserEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value?.ToLowerInvariant() ?? "";
                        var isCallCenterUser = currentUserEmail.Contains("cagri") || 
                                               currentUserEmail.Contains("zeynep.kaya") || 
                                               currentUserEmail.Contains("can.yilmaz") || 
                                               currentUserEmail.Contains("selin.sahin") ||
                                               User.IsInRole("CallCenterAgent");

                        if (isCallCenterUser)
                        {
                            <a href="/Tickets/Ticket/CagriMerkezi" class="menu-link submenu-link" style="color:#059669; font-weight:700;">
                                <i class="fa-solid fa-headset menu-icon"></i>
                                <span class="menu-text">Çağrı Merkezi &amp; Tedarikçi Havuzu</span>
                            </a>
                        }
                        <a href="/Tickets/Report/Index" class="menu-link submenu-link">
                            <i class="fa-solid fa-file-invoice-dollar menu-icon"></i>
                            <span class="menu-text">Kurumsal Raporlama &amp; Export</span>
                        </a>
                        <a href="/Tickets/Faq/Index" class="menu-link submenu-link">
                            <i class="fa-solid fa-book-bookmark menu-icon"></i>
                            <span class="menu-text">Bilgi Bankası & SSS</span>
                        </a>
                        <a href="/Tickets/Chat/Index" class="menu-link submenu-link">
                            <i class="fa-solid fa-comments menu-icon"></i>
                            <span class="menu-text">Birim İçi Mesajlaşma</span>
                        </a>
                    }
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(menu.Parent.Url))
        {
            <a href="@SafeUrl(menu.Parent.Url)" class="menu-link">
                @Html.Raw(GetIcon(menu.Parent.Icon))
                <span class="menu-text">@menu.Parent.Name</span>
            </a>
        }
    }
}
else
{
    <a href="/" class="menu-link">
        <i class="fa-solid fa-table-cells-large menu-icon"></i>
        <span class="menu-text">Dashboard</span>
    </a>
}
