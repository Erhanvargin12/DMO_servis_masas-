@using WebUI.Models.ViewModels
@model MenuViewModel

@functions {
    string SafeUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "#";
        // Relative URL ise başına / ekle (http/https ve # hariç)
        if (url.StartsWith("/") || url.StartsWith("http") || url.StartsWith("#"))
            return url;
        return "/" + url;
    }

    string GetIcon(string? iconName)
    {
        var fa = iconName switch
        {
            "dashboard"    => "fa-table-cells-large",
            "users"        => "fa-users",
            "roles"        => "fa-shield-halved",
            "organization" => "fa-building",
            "settings"     => "fa-gear",
            "logs"         => "fa-file-lines",
            "menu"         => "fa-bars",
            "folder"       => "fa-folder",
            _              => "fa-circle"
        };
        return $"<i class=\"fa-solid {fa} menu-icon\"></i>";
    }
}

@if (Model != null && Model.Menu.Any())
{
    foreach (var menu in Model.Menu)
    {
        var hasChildren = menu.Childrens.Any();

        if (hasChildren)
        {
            <div class="menu-group">
                <a href="javascript:void(0)" class="menu-link has-submenu" data-toggle="submenu" data-menu-id="@menu.Parent.Id">
                    @Html.Raw(GetIcon(menu.Parent.Icon))
                    <span class="menu-text">@menu.Parent.Name</span>
                    <i class="fa-solid fa-chevron-down submenu-arrow"></i>
                </a>
                <div class="submenu" data-parent-menu-id="@menu.Parent.Id">
                    @foreach (var child in menu.Childrens!.OrderBy(c => c.Children.DisplayOrder))
                    {
                        <a href="@SafeUrl(child.Children.Url)" class="menu-link submenu-link">
                            @Html.Raw(GetIcon(child.Children.Icon))
                            <span class="menu-text">@child.Children.Name</span>
                        </a>
                    }
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(menu.Parent.Url))
        {
            <a href="@SafeUrl(menu.Parent.Url)" class="menu-link">
                @Html.Raw(GetIcon(menu.Parent.Icon))
                <span class="menu-text">@menu.Parent.Name</span>
            </a>
        }
    }
}
else
{
    <a href="/" class="menu-link">
        <i class="fa-solid fa-table-cells-large menu-icon"></i>
        <span class="menu-text">Dashboard</span>
    </a>
}
