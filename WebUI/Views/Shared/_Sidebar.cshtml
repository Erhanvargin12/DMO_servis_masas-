<aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="sidebar-logo">B</div>
        <span class="sidebar-brand">DIP</span>
    </div>

    <nav class="sidebar-menu">
        @await Component.InvokeAsync("DynamicMenu")
    </nav>

    <div class="sidebar-footer">
        <div class="user-card">
            <div class="user-avatar">
                @(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value?.Substring(0, 1).ToUpper() ?? "U")
            </div>
            <div class="user-info">
                <div class="user-name">@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "Kullanıcı")</div>
                <div class="user-role">Yönetici</div>
            </div>
        </div>
    </div>
</aside>

<div class="mobile-overlay" id="mobileOverlay"></div>
