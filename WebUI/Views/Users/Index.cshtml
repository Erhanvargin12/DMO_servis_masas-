@using WebUI.Models
@using WebUI.Models.ViewModels
@model UserListViewModel
@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="mgmt-page-header">
    <div class="mgmt-page-header-left">
        <div class="mgmt-page-icon">
            <i class="fa-solid fa-users"></i>
        </div>
        <div>
            <div class="mgmt-page-title">Kullanıcı Yönetimi</div>
            <div class="mgmt-page-subtitle">Sistem kullanıcılarını yönetin ve roller atayın</div>
        </div>
    </div>
    <button type="button" class="btn btn-primary" data-modal-open="userModal">
        <i class="fa-solid fa-plus"></i>
        Yeni Kullanıcı
    </button>
</div>
<!-- Filtre Çubuğu -->
<div class="data-table" style="margin-bottom:16px;">
    <div class="filter-wrap">
        <form method="get" asp-action="Index" asp-controller="Users" class="filter-form">
            <div class="filter-row">
                <div class="data-table-search filter-search">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input type="text" name="search" value="@Model.SearchTerm"
                           placeholder="Ad, soyad veya e-posta ara..." autocomplete="off" />
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn btn-primary filter-btn">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        Ara
                    </button>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <a href="@Url.Action("Index", "Users")" class="btn filter-btn">
                            <i class="fa-solid fa-xmark"></i>
                            Temizle
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<div class="data-table">
    <div class="data-table-header">
        <div class="data-table-title">
            <span>Kullanıcı Listesi</span>
            <span class="stat-chip"></span>
        </div>
        <div class="data-table-actions"></div>
    </div>

    <div class="table-container">
        <table class="table mgmt-table" data-paginate data-page-size="10">
            <thead>
                <tr>
                    <th data-sort="text">Kullanıcı</th>
                    <th data-sort="text" class="col-hide-md">E-posta</th>
                    <th data-sort="num"  class="col-hide-md">Sicil No</th>
                    <th data-sort="text">Durum</th>
                    <th data-sort="text" class="col-hide-md">Kayıt Tarihi</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Any())
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr data-item-id="@user.User.Id"
                            data-role-ids='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(user.UserRoles.Select(s => s.OperationClaimId)))'
                            data-item='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(user.User, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null }))'>
                            <td data-label="Kullanıcı">
                                <div class="entity-cell">
                                    <div class="entity-badge entity-badge-user">@user.User.FirstName[..1].ToUpper()</div>
                                    <div class="entity-info">
                                        <span class="entity-name">@user.User.FirstName @user.User.LastName</span>
                                        <span class="entity-meta">ID: @user.User.Id</span>
                                    </div>
                                </div>
                            </td>
                            <td class="entity-desc col-hide-md" data-label="E-posta">@user.User.Mail</td>
                            <td class="col-hide-md" data-label="Sicil No"><span class="entity-id">@user.User.EbysUserId</span></td>
                            <td data-label="Durum"><span class="badge @(user.User.Status ? "badge-success" : "badge-error")">@(user.User.Status ? "Aktif" : "Pasif")</span></td>
                            <td class="text-muted col-hide-md" data-label="Tarih">@user.User.CreateAt.ToString("dd.MM.yyyy")</td>
                            <td>
                                <div class="table-actions">
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Rol Ata" data-assign-roles data-item-id="@user.User.Id">
                                        <i class="fa-solid fa-shield-halved"></i>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Düzenle" data-modal-open="userModal" data-item-id="@user.User.Id">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm btn-icon-danger" title="Sil" data-delete="@user.User.Id" data-delete-name="@user.User.FirstName @user.User.LastName">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="mgmt-empty">
                                <div class="mgmt-empty-icon">
                                    <i class="fa-solid fa-users"></i>
                                </div>
                                <p class="mgmt-empty-title">
                                    @(string.IsNullOrEmpty(Model.SearchTerm) ? "Kullanıcı bulunamadı" : $"'{Model.SearchTerm}' için sonuç bulunamadı")
                                </p>
                                <p class="mgmt-empty-text">
                                    @(string.IsNullOrEmpty(Model.SearchTerm) ? "Yeni kullanıcı eklemek için butonu kullanın" : "Farklı bir arama terimi deneyin")
                                </p>
                            </div>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
    <div class="data-table-footer"><div class="data-table-info"></div></div>
</div>

<!-- Modal -->
<div class="modal-overlay" id="userModal">
    <div class="modal modal-md">
        <div class="modal-header">
            <h3 class="modal-title"
                data-create-title="Yeni Kullanıcı Ekle"
                data-edit-title="Kullanıcı Düzenle">
                Yeni Kullanıcı Ekle
            </h3>
            <button type="button" class="modal-close" data-modal-close>
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form asp-controller="Users" asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="0" />
            <div class="modal-body">
                <div class="form-section-title">Kişisel Bilgiler</div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label required">Ad</label>
                        <input type="text" name="FirstName" class="form-input" placeholder="Adı girin" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label required">Soyad</label>
                        <input type="text" name="LastName" class="form-input" placeholder="Soyadı girin" required />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label required">E-posta</label>
                    <input type="email" name="Mail" class="form-input" placeholder="ornek@email.com" required />
                </div>
                <div class="form-group" id="passwordGroup">
                    <label class="form-label required" id="passwordLabel">Şifre</label>
                    <input type="password" name="Password" class="form-input"
                           placeholder="En az 6 karakter" id="passwordInput"
                           minlength="6" autocomplete="new-password" />
                </div>
                <div class="form-section-title" style="margin-top:16px;">Sistem Bilgileri</div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Sicil No</label>
                        <input type="text" name="EbysUserId" class="form-input" placeholder="Sicil No girin" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ebys Şube Id</label>
                        <input type="text" name="BranchId" class="form-input" placeholder="Şube ID girin" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Pozisyon ID</label>
                        <input type="number" name="PositionId" class="form-input" value="0" min="0" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Durum</label>
                        <div class="form-check">
                            <input type="checkbox" name="Status" value="true" class="form-checkbox" id="userStatus" checked />
                            <label for="userStatus">Aktif</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary" data-create-text="Kaydet" data-edit-text="Güncelle">Kaydet</button>
            </div>
        </form>
    </div>
</div>
<div class="modal-overlay" id="deleteModal">
    <div class="modal modal-xs modal-compact">
        <div class="modal-header">
            <h3 class="modal-title">Silme Onayı</h3>
            <button type="button" class="modal-close" data-modal-close>
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form asp-controller="Users" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteModalItemId" value="" />
            <div class="modal-body">
                <div class="delete-confirm">
                    <div class="delete-confirm-icon">
                        <i class="fa-solid fa-trash"></i>
                    </div>
                    <p class="delete-confirm-title">Silmek istediğinize emin misiniz?</p>
                    <p class="delete-confirm-name" id="deleteModalItemName"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>Vazgeç</button>
                <button type="submit" class="btn btn-danger">Sil</button>
            </div>
        </form>
    </div>
</div>
<div class="modal-overlay" id="rolesModal">
    <div class="modal modal-sm">
        <div class="modal-header">
            <h3 class="modal-title">Rol Ata</h3>
            <button type="button" class="modal-close" data-modal-close>
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form asp-controller="Users" asp-action="AssignRoles" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" id="rolesModalUserId" value="0" />
            <div class="modal-body">
                <div class="assign-entity-info" style="margin-bottom:16px;">
                    <div class="assign-entity-badge" id="rolesModalBadge">?</div>
                    <div>
                        <div class="assign-entity-name" id="rolesModalName">—</div>
                        <div class="assign-help-text" id="rolesModalMeta">—</div>
                    </div>
                </div>
                @if (Model.AllRoles.Any())
                {
                    <div class="assign-help-text" style="margin-bottom:10px;">Atamak istediğiniz rolleri seçin:</div>
                    <div class="role-list">
                        @foreach (var role in Model.AllRoles)
                        {
                            <label class="role-item">
                                <input type="checkbox" class="role-checkbox" name="selectedRoleIds" value="@role.Id" />
                                <div class="role-info">
                                    <span class="role-name">@role.Name</span>
                                    @if (!string.IsNullOrEmpty(role.Description))
                                    {
                                        <span class="role-desc">@role.Description</span>
                                    }
                                </div>
                            </label>
                        }
                    </div>
                }
                else
                {
                    <div class="mgmt-empty"><p class="mgmt-empty-title">Sistemde rol bulunamadı</p></div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i>
                    Rolleri Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/users.js" asp-append-version="true"></script>
}
