@model WebUI.Models.UserListViewModel
@{
    ViewData["Title"] = "Kullanıcılar";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-header-title">Kullanıcı Yönetimi</h1>
        <p class="page-header-subtitle">Sistem kullanıcılarını yönetin ve roller atayın</p>
    </div>
    <button type="button" class="btn btn-primary" data-modal-open="userModal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Yeni Kullanıcı
    </button>
</div>

<!-- Data Table -->
<div class="data-table">
    <div class="data-table-header">
        <div class="data-table-title">
            <span>Kullanıcı Listesi</span>
            <span class="data-table-count">@Model.TotalCount kayıt</span>
        </div>
        <div class="data-table-actions">
            <div class="data-table-search">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" placeholder="Kullanıcı ara..." id="tableSearch" autocomplete="off" />
            </div>
        </div>
    </div>

    <div class="table-container">
        <table class="table" id="usersTable">
            <thead>
                <tr>
                    <th width="25%">Kullanıcı</th>
                    <th width="25%">E-posta</th>
                    <th width="12%">Sicil No</th>
                    <th width="10%">Durum</th>
                    <th width="13%">Kayıt Tarihi</th>
                    <th width="15%"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Any())
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr data-item-id="@user.Id" data-item='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(user, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null }))'>
                            <td>
                                <div class="cell-user">
                                    <div class="cell-avatar">@user.FirstName[..1].ToUpper()</div>
                                    <div class="cell-name">@user.FullName</div>
                                </div>
                            </td>
                            <td>@user.Mail</td>
                            <td><span class="cell-id">@user.RegistirationId</span></td>
                            <td>
                                <span class="badge @(user.Status ? "badge-success" : "badge-error")">
                                    @(user.Status ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-muted">@user.CreateAt.ToString("dd.MM.yyyy")</td>
                            <td>
                                <div class="table-actions">
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Roller"
                                            data-role-modal="@user.Id" data-user-name="@user.FullName">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                        </svg>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Düzenle"
                                            data-modal-open="userModal" data-item-id="@user.Id">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm btn-icon-danger" title="Sil"
                                            data-delete="@user.Id" data-delete-name="@user.FullName">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6"/>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="empty-row">
                        <td colspan="6" class="empty-state">
                            <div class="empty-state-icon">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                    <circle cx="9" cy="7" r="4"/>
                                </svg>
                            </div>
                            <p class="empty-state-title">Kullanıcı bulunamadı</p>
                            <p class="empty-state-text">Yeni kullanıcı eklemek için butonu kullanın</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="data-table-footer">
        <div class="data-table-info" id="paginationInfo">Toplam @Model.TotalCount kullanıcı</div>
        <div class="data-table-pagination" id="pagination"></div>
    </div>
</div>

<!-- User Modal - Yatay form düzeni -->
<div class="modal-overlay" id="userModal">
    <div class="modal modal-md">
        <div class="modal-header">
            <h3 class="modal-title" data-create-title="Yeni Kullanıcı Ekle" data-edit-title="Kullanıcı Düzenle">Yeni Kullanıcı Ekle</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form class="ajax-form" asp-controller="Users" asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="0" />
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label required">Ad</label>
                        <input type="text" name="FirstName" class="form-input" placeholder="Adı girin" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label required">Soyad</label>
                        <input type="text" name="LastName" class="form-input" placeholder="Soyadı girin" required />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label required">E-posta</label>
                    <input type="email" name="Mail" class="form-input" placeholder="ornek@email.com" required />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Sicil No</label>
                        <input type="number" name="RegistirationId" class="form-input" value="0" min="0" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Organizasyon ID</label>
                        <input type="number" name="OrganizationUnitId" class="form-input" value="0" min="0" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Pozisyon ID</label>
                        <input type="number" name="PositionId" class="form-input" value="0" min="0" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Durum</label>
                        <div class="form-check" style="margin-top: 8px;">
                            <input type="checkbox" name="Status" class="form-checkbox" id="userStatus" checked />
                            <label for="userStatus">Aktif</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary" data-create-text="Kaydet" data-edit-text="Güncelle">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<!-- Roles Modal - Uzun liste için tall modal -->
<div class="modal-overlay" id="rolesModal">
    <div class="modal modal-sm modal-tall">
        <div class="modal-header">
            <h3 class="modal-title">Kullanıcı Rolleri</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <div class="modal-body">
            <div class="role-user-info">
                <div class="role-user-avatar" id="roleUserAvatar">U</div>
                <div class="role-user-name" id="roleUserName">Kullanıcı Adı</div>
            </div>
            <p class="role-help-text">Bu kullanıcıya atanacak rolleri seçin:</p>
            <div class="role-list" id="roleList">
                @foreach (var role in Model.Roles)
                {
                    <label class="role-item">
                        <input type="checkbox" class="role-checkbox" value="@role.Id" />
                        <div class="role-info">
                            <span class="role-name">@role.Name</span>
                            @if (!string.IsNullOrEmpty(role.Description))
                            {
                                <span class="role-desc">@role.Description</span>
                            }
                        </div>
                    </label>
                }
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn" data-modal-close>İptal</button>
            <button type="button" class="btn btn-primary" id="saveRolesBtn">Kaydet</button>
        </div>
    </div>
</div>

<!-- Delete Modal - Küçük ve kompakt -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal modal-xs modal-compact">
        <div class="modal-header">
            <h3 class="modal-title">Silme Onayı</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-controller="Users" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteModalItemId" value="" />
            <div class="modal-body">
                <div class="delete-content">
                    <div class="delete-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                        </svg>
                    </div>
                    <p class="delete-title">Silmek istediğinize emin misiniz?</p>
                    <p class="delete-name" id="deleteModalItemName"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>Vazgeç</button>
                <button type="submit" class="btn btn-danger">Sil</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/users.js" asp-append-version="true"></script>
}
