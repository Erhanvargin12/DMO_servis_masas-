@model WebUI.Models.UserListViewModel
@{
    ViewData["Title"] = "Kullanıcılar";
}

<!-- Page Header -->
<div class="mgmt-page-header">
    <div class="mgmt-page-header-left">
        <div class="mgmt-page-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
        </div>
        <div>
            <div class="mgmt-page-title">Kullanıcı Yönetimi</div>
            <div class="mgmt-page-subtitle">Sistem kullanıcılarını yönetin ve roller atayın</div>
        </div>
    </div>
    <button type="button" class="btn btn-primary" data-modal-open="userModal">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Yeni Kullanıcı
    </button>
</div>

<!-- Data Table -->
<div class="data-table">
    <div class="data-table-header">
        <div class="data-table-title">
            <span>Kullanıcı Listesi</span>
            <span class="stat-chip">@Model.TotalCount kayıt</span>
        </div>
        <div class="data-table-actions">
            <!-- Server-side arama formu -->
            <form method="get" asp-action="Index" asp-controller="Users" class="data-table-search">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" name="search" value="@Model.SearchTerm"
                       placeholder="Ad, soyad veya e-posta ara..."
                       autocomplete="off" />
            </form>
        </div>
    </div>

    <div class="table-container">
        <table class="table mgmt-table" id="usersTable">
            <thead>
                <tr>
                    <th width="28%">Kullanıcı</th>
                    <th width="25%">E-posta</th>
                    <th width="12%">Sicil No</th>
                    <th width="10%">Durum</th>
                    <th width="12%">Kayıt Tarihi</th>
                    <th width="13%"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Any())
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr data-item-id="@user.Id"
                            data-role-ids='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(user.AssignedRoleIds))'
                            data-item='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(user, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null }))'>
                            <td>
                                <div class="entity-cell">
                                    <div class="entity-badge entity-badge-user">@user.FirstName[..1].ToUpper()</div>
                                    <div class="entity-info">
                                        <span class="entity-name">@user.FullName</span>
                                        <span class="entity-meta">ID: @user.Id</span>
                                    </div>
                                </div>
                            </td>
                            <td class="entity-desc">@user.Mail</td>
                            <td><span class="entity-id">@user.RegistirationId</span></td>
                            <td>
                                <span class="badge @(user.Status ? "badge-success" : "badge-error")">
                                    @(user.Status ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-muted">@user.CreateAt.ToString("dd.MM.yyyy")</td>
                            <td>
                                <div class="table-actions">
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Rol Ata"
                                            data-assign-roles data-item-id="@user.Id">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                        </svg>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm" title="Düzenle"
                                            data-modal-open="userModal" data-item-id="@user.Id">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-ghost btn-sm btn-icon-danger" title="Sil"
                                            data-delete="@user.Id" data-delete-name="@user.FullName">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6"/>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="mgmt-empty">
                                <div class="mgmt-empty-icon">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                    </svg>
                                </div>
                                <p class="mgmt-empty-title">
                                    @(string.IsNullOrEmpty(Model.SearchTerm) ? "Kullanıcı bulunamadı" : $"'{Model.SearchTerm}' için sonuç bulunamadı")
                                </p>
                                <p class="mgmt-empty-text">
                                    @(string.IsNullOrEmpty(Model.SearchTerm) ? "Yeni kullanıcı eklemek için butonu kullanın" : "Farklı bir arama terimi deneyin")
                                </p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Server-side Pagination -->
    <partial name="_Pagination" model="Model.ToPagination()" />
</div>

<!-- User Modal (Ekle / Düzenle) -->
<div class="modal-overlay" id="userModal">
    <div class="modal modal-md">
        <div class="modal-header">
            <h3 class="modal-title"
                data-create-title="Yeni Kullanıcı Ekle"
                data-edit-title="Kullanıcı Düzenle">Yeni Kullanıcı Ekle</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-controller="Users" asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="0" />
            <div class="modal-body">
                <div class="form-section-title">Kişisel Bilgiler</div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label required">Ad</label>
                        <input type="text" name="FirstName" class="form-input" placeholder="Adı girin" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label required">Soyad</label>
                        <input type="text" name="LastName" class="form-input" placeholder="Soyadı girin" required />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label required">E-posta</label>
                    <input type="email" name="Mail" class="form-input" placeholder="ornek@email.com" required />
                </div>
                <div class="form-group" id="passwordGroup">
                    <label class="form-label required" id="passwordLabel">Şifre</label>
                    <input type="password" name="Password" class="form-input"
                           placeholder="En az 6 karakter" id="passwordInput"
                           minlength="6" autocomplete="new-password" />
                </div>
                <div class="form-section-title" style="margin-top:16px;">Sistem Bilgileri</div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Sicil No</label>
                        <input type="number" name="RegistirationId" class="form-input" value="0" min="0" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Organizasyon ID</label>
                        <input type="number" name="OrganizationUnitId" class="form-input" value="0" min="0" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Pozisyon ID</label>
                        <input type="number" name="PositionId" class="form-input" value="0" min="0" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Durum</label>
                        <div class="form-check" style="margin-top: 8px;">
                            <input type="checkbox" name="Status" value="true" class="form-checkbox" id="userStatus" checked />
                            <label for="userStatus">Aktif</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary"
                        data-create-text="Kaydet" data-edit-text="Güncelle">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal modal-xs modal-compact">
        <div class="modal-header">
            <h3 class="modal-title">Silme Onayı</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-controller="Users" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteModalItemId" value="" />
            <div class="modal-body">
                <div class="delete-confirm">
                    <div class="delete-confirm-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                        </svg>
                    </div>
                    <p class="delete-confirm-title">Silmek istediğinize emin misiniz?</p>
                    <p class="delete-confirm-name" id="deleteModalItemName"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>Vazgeç</button>
                <button type="submit" class="btn btn-danger">Sil</button>
            </div>
        </form>
    </div>
</div>

<!-- Roles Modal -->
<div class="modal-overlay" id="rolesModal">
    <div class="modal modal-sm">
        <div class="modal-header">
            <h3 class="modal-title">Rol Ata</h3>
            <button type="button" class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form asp-controller="Users" asp-action="AssignRoles" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" id="rolesModalUserId" value="0" />
            <div class="modal-body">
                <div class="assign-entity-info" style="margin-bottom:16px;">
                    <div class="assign-entity-badge" id="rolesModalBadge">?</div>
                    <div>
                        <div class="assign-entity-name" id="rolesModalName">—</div>
                        <div class="assign-help-text" id="rolesModalMeta">—</div>
                    </div>
                </div>
                @if (Model.AllRoles.Any())
                {
                    <div class="assign-help-text" style="margin-bottom:10px;">Atamak istediğiniz rolleri seçin:</div>
                    <div class="role-list">
                        @foreach (var role in Model.AllRoles)
                        {
                            <label class="role-item">
                                <input type="checkbox" class="role-checkbox" name="selectedRoleIds" value="@role.Id" />
                                <div class="role-info">
                                    <span class="role-name">@role.Name</span>
                                    @if (!string.IsNullOrEmpty(role.Description))
                                    {
                                        <span class="role-desc">@role.Description</span>
                                    }
                                </div>
                            </label>
                        }
                    </div>
                }
                else
                {
                    <div class="mgmt-empty"><p class="mgmt-empty-title">Sistemde rol bulunamadı</p></div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-modal-close>İptal</button>
                <button type="submit" class="btn btn-primary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    Rolleri Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/users.js" asp-append-version="true"></script>
}
